.racket-edit-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
  background-attachment: fixed;
}

.racket-edit-scroll {
  flex: 1;
  min-height: 0;
}

.racket-edit-content {
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.edit-hero {
  padding: 26rpx 0 44rpx;
}

.edit-title {
  display: block;
  color: #05070c;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.12;
}

.racket-detail-card {
  display: flex;
  gap: 28rpx;
  margin-bottom: 28rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
}

.detail-image-wrap {
  flex: none;
  width: 170rpx;
  height: 132rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-image {
  width: 150rpx;
  height: 110rpx;
}

.detail-mark {
  color: rgba(13, 23, 40, 0.58);
  font-size: 28rpx;
  font-weight: 900;
}

.detail-copy {
  flex: 1;
  min-width: 0;
}

.detail-name {
  display: block;
  color: #05070c;
  font-size: 34rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-brand {
  display: block;
  margin-top: 10rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 26rpx;
  font-weight: 800;
}

.detail-specs {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
  color: #3778db;
  font-size: 24rpx;
  font-weight: 900;
}

.field-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.input-card {
  min-height: 92rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  box-sizing: border-box;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.input-card text {
  flex: none;
  width: 96rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 26rpx;
  font-weight: 700;
}

.input-card input,
.picker-inline {
  flex: 1;
  min-width: 0;
  color: #17251c;
  font-size: 30rpx;
  text-align: right;
}

.section-label {
  margin: 34rpx 0 16rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 26rpx;
  font-weight: 800;
}

.bottom-action-area {
  flex-shrink: 0;
  padding: 24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(238, 214, 202, 0) 0%, rgba(238, 214, 202, 0.95) 100%);
  box-sizing: border-box;
}

.submit-button {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: #3778db;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 96rpx;
  box-shadow: 0 8rpx 24rpx rgba(55, 120, 219, 0.3);
}
