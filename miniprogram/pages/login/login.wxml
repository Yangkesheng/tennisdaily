<navigation-bar title="" back="{{false}}" color="#05070c" background="transparent"></navigation-bar>
<view class="page login-page">
  <view class="login-content">
    <view class="brand-block">
      <text class="brand">TENNIS DAY</text>
      <text class="title">记录每一次上场</text>
      <text class="subtitle">10 秒记录打球，管理球拍、穿线和网球投入。</text>
    </view>

    <view class="feature-card">
      <view class="feature-row">
        <text class="feature-dot"></text>
        <text>微信登录用于识别账号和同步数据</text>
      </view>
      <view class="feature-row">
        <text class="feature-dot"></text>
        <text>换设备后可继续查看你的记录</text>
      </view>
      <view class="feature-row">
        <text class="feature-dot"></text>
        <text>不会公开展示你的个人信息</text>
      </view>
    </view>
    <view wx:if="{{needsNickname}}" class="nickname-card">
      <text class="nickname-title">设置昵称</text>
      <text class="nickname-desc">首次登录请设置一个昵称，之后会展示在我的页面。</text>
      <text wx:if="{{showNicknameTip}}" class="nickname-tip">请点击昵称输入框授权微信昵称，或手动输入昵称</text>
      <input
        class="nickname-input"
        type="nickname"
        value="{{nickname}}"
        placeholder="请输入昵称"
        focus="{{nicknameInputFocus}}"
        bindinput="onNicknameInput"
      />
    </view>
  </view>

  <view class="login-bottom">
    <button
      wx:if="{{!needsNickname}}"
      class="login-button {{isLoggingIn ? 'disabled' : ''}}"
      bindtap="onLogin"
      loading="{{isLoggingIn}}"
      disabled="{{isLoggingIn}}"
    >
      登录
    </button>
    <button
      wx:else
      class="login-button {{isSavingNickname ? 'disabled' : ''}}"
      bindtap="enterWithNickname"
      loading="{{isSavingNickname}}"
      disabled="{{isSavingNickname}}"
    >
      进入
    </button>
  </view>

  <privacy-dialog
    visible="{{showPrivacyDialog}}"
    bindaccept="onAcceptPrivacy"
    bindreject="onRejectPrivacy"
    bindopenpolicy="openPrivacyPolicy"
  ></privacy-dialog>
</view>
