.login-page {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #05070c;
}

.login-content {
  padding-top: 120rpx;
}

.brand {
  display: block;
  color: rgba(13, 23, 40, 0.48);
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.title {
  display: block;
  margin-top: 26rpx;
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1.16;
}

.subtitle {
  display: block;
  width: 520rpx;
  margin-top: 22rpx;
  color: rgba(13, 23, 40, 0.58);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.6;
}

.feature-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 74rpx;
  padding: 34rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.52);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.76);
  backdrop-filter: blur(20px);
}

.feature-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: rgba(13, 23, 40, 0.68);
  font-size: 28rpx;
  font-weight: 800;
}

.feature-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #3778db;
}

.nickname-card {
  margin-top: 34rpx;
  padding: 34rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
}

.nickname-title {
  display: block;
  color: #05070c;
  font-size: 34rpx;
  font-weight: 900;
}

.nickname-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(13, 23, 40, 0.56);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.nickname-tip {
  display: block;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(55, 120, 219, 0.1);
  color: #245fae;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.nickname-input {
  height: 82rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #05070c;
  font-size: 30rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.login-bottom {
  padding-bottom: 8rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.checkbox {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid rgba(13, 23, 40, 0.36);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.checkbox.checked {
  border-color: #3778db;
  background: #3778db;
}

.agreement-text {
  color: rgba(13, 23, 40, 0.52);
  font-size: 22rpx;
  font-weight: 700;
}

.login-button {
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: 32rpx;
  background: #3778db;
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 96rpx;
  box-shadow: 0 18rpx 44rpx rgba(55, 120, 219, 0.28);
}

.login-button.disabled {
  opacity: 0.72;
}

.login-button:active {
  opacity: 0.82;
}
