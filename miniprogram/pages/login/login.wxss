.login-page {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(160deg, #cfd6ff 0%, #8fc3f7 48%, #eef5fb 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-card {
  width: 100%;
  padding: 64rpx 40rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 24rpx 72rpx rgba(68, 112, 173, 0.22);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-mark {
  width: 128rpx;
  height: 128rpx;
  border-radius: 40rpx;
  background: #3778db;
  color: #fff;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 128rpx;
  text-align: center;
  box-shadow: 0 18rpx 44rpx rgba(55, 120, 219, 0.28);
}

.login-title {
  margin-top: 34rpx;
  color: #05070c;
  font-size: 56rpx;
  font-weight: 800;
}

.login-subtitle {
  margin-top: 16rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 30rpx;
  font-weight: 700;
}

.login-button {
  width: 100%;
  height: 96rpx;
  margin-top: 72rpx;
  padding: 0;
  border-radius: 30rpx;
  background: #3778db;
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 96rpx;
  box-shadow: 0 18rpx 44rpx rgba(55, 120, 219, 0.28);
}

.login-button:active {
  opacity: 0.82;
}

.login-tip {
  margin-top: 24rpx;
  color: rgba(13, 23, 40, 0.42);
  font-size: 24rpx;
  font-weight: 700;
}
