.settings-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
  box-sizing: border-box;
  color: #05070c;
}

.settings-loading,
.settings-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 160rpx 40rpx;
}

.settings-loading-text,
.settings-error-text {
  color: rgba(13, 23, 40, 0.52);
  font-size: 28rpx;
  font-weight: 600;
}

.settings-retry-button {
  width: 240rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: #3778db;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
}

.settings-card {
  padding: 30rpx 30rpx 10rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66);
}

.card-head {
  padding-bottom: 8rpx;
}

.card-title {
  color: rgba(13, 23, 40, 0.78);
  font-size: 28rpx;
  font-weight: 800;
}

.setting-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 2rpx;
}

.setting-row + .setting-row {
  border-top: 1rpx solid rgba(13, 23, 40, 0.08);
}

.setting-row:active {
  opacity: 0.72;
}

.setting-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.setting-label {
  color: #05070c;
  font-size: 28rpx;
  font-weight: 800;
}

.setting-sub {
  color: rgba(13, 23, 40, 0.48);
  font-size: 22rpx;
  font-weight: 600;
}

.setting-value {
  max-width: 300rpx;
  color: rgba(13, 23, 40, 0.68);
  font-size: 26rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.setting-arrow {
  flex: none;
  color: rgba(13, 23, 40, 0.42);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.settings-popup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(5, 7, 12, 0.38);
}

.settings-popup {
  width: 100%;
  padding: 34rpx 34rpx calc(42rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #f9f4ee;
  box-sizing: border-box;
}

.settings-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.settings-popup-title {
  color: #05070c;
  font-size: 34rpx;
  font-weight: 900;
}

.settings-popup-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(13, 23, 40, 0.08);
  color: rgba(13, 23, 40, 0.56);
  font-size: 40rpx;
  font-weight: 500;
  line-height: 54rpx;
  text-align: center;
}

.settings-popup-desc {
  display: block;
  margin-top: 16rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.settings-popup-input {
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #05070c;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.duration-preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.duration-preset {
  min-width: 150rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(13, 23, 40, 0.06);
  color: rgba(13, 23, 40, 0.72);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 72rpx;
  text-align: center;
}

.duration-preset.active {
  background: #3778db;
  color: #fff;
}

.save-button {
  width: 100%;
  height: 84rpx;
  margin-top: 28rpx;
  border-radius: 28rpx;
  background: #3778db;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.save-button::after {
  border: 0;
}

.save-button:active {
  opacity: 0.84;
}
