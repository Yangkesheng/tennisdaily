<navigation-bar title="球鞋详情" back="{{true}}" color="#05070c" background="transparent"></navigation-bar>
<scroll-view class="page shoe-detail-page" scroll-y>
  <view wx:if="{{shoe}}" class="detail-content">
    <view class="hero-card">
      <view class="shoe-mark">
        <image wx:if="{{shoe.imageUrl}}" class="shoe-image" src="{{shoe.imageUrl}}" mode="aspectFit" bindtap="previewShoeImage"></image>
        <text wx:else>{{shoe.brand || 'S'}}</text>
      </view>
      <view class="hero-copy">
        <view class="title-row">
          <text class="shoe-name">{{shoe.name}}</text>
          <text wx:if="{{statusLabel}}" class="status-badge {{statusClass}}">{{statusLabel}}</text>
        </view>
        <text wx:if="{{modelText}}" class="shoe-model">{{modelText}}</text>
        <text class="purchase-line">{{shoe.purchaseDate || '-'}} · ¥{{purchasePriceText}}</text>
        <view class="edit-button" bindtap="goEdit">编辑</view>
      </view>
    </view>

    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{shoe.usageCount}}</text>
        <text class="stat-label">累计次数</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{shoe.usageHours}}h</text>
        <text class="stat-label">累计时间</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{shoe.wear ? shoe.wear.remainingHours : '-'}}</text>
        <text class="stat-label">剩余寿命</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{wearScoreText}}</text>
        <text class="stat-label">健康度</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-header">
        <text class="section-title">健康度</text>
      </view>
      <view wx:if="{{shoe.wear}}" class="wear-panel wear-{{shoe.wear.state}}">
        <text class="wear-text">{{shoe.wear.display}}</text>
        <view class="wear-segments">
          <view
            wx:for="{{wearSegments}}"
            wx:key="key"
            class="wear-segment {{item.on ? 'on' : ''}}"
          ></view>
        </view>
        <view class="wear-foot">
          <text>剩余 {{shoe.wear.remainingHours}}h</text>
          <text>{{wearScoreText}}</text>
        </view>
      </view>
      <view wx:else class="empty-text">暂无磨损数据</view>
    </view>

    <view class="section-card">
      <view class="section-header">
        <text class="section-title">球鞋信息</text>
      </view>
      <view wx:if="{{infoRows.length}}" class="info-list">
        <view wx:for="{{infoRows}}" wx:key="label" class="info-row">
          <text class="info-label">{{item.label}}</text>
          <text class="info-value">{{item.value}}</text>
        </view>
      </view>
      <view wx:else class="empty-text">暂无信息</view>
    </view>
  </view>
</scroll-view>
