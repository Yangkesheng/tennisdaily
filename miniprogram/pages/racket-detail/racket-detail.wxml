<navigation-bar title="球拍详情" back="{{true}}" color="#05070c" background="transparent"></navigation-bar>
<scroll-view class="page racket-detail-page" scroll-y>
  <view wx:if="{{racket}}" class="detail-content">
    <view class="hero-card">
      <view class="racket-mark">
        <image wx:if="{{racket.imageUrl}}" class="racket-image" src="{{racket.imageUrl}}" mode="aspectFit"></image>
        <text wx:else>{{racket.brand || 'T'}}</text>
      </view>
      <view class="hero-copy">
        <view class="title-row">
          <text class="racket-name">{{racket.name}}</text>
          <text wx:if="{{statusLabel}}" class="status-badge {{statusClass}}">{{statusLabel}}</text>
        </view>
        <text class="racket-model">{{racket.brand}} {{racket.model}}</text>
        <text class="purchase-line">{{racket.purchaseDate || '-'}} · ¥{{purchasePriceText}}</text>
        <view class="edit-button" bindtap="goEdit">编辑</view>
      </view>
    </view>

    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{racket.usageCount}}</text>
        <text class="stat-label">累计次数</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{racket.usageHours}}h</text>
        <text class="stat-label">累计时间</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{racket.afterStringingUsageCount}}</text>
        <text class="stat-label">穿线后次数</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{racket.afterStringingUsageHours}}h</text>
        <text class="stat-label">穿线后时间</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-header">
        <text class="section-title">穿线记录</text>
        <view class="small-button" bindtap="goStringing">新增</view>
      </view>
      <view wx:if="{{stringingRecords.length}}" class="stringing-list">
        <view wx:for="{{stringingRecords}}" wx:key="id" class="stringing-swipe-row">
          <button wx:if="{{openedRecordId === item.id}}" class="stringing-delete-action" data-id="{{item.id}}" catchtap="deleteStringingRecord">删除</button>
          <view
            class="stringing-row {{openedRecordId === item.id ? 'opened' : ''}}"
            data-id="{{item.id}}"
            bindtouchstart="onRecordTouchStart"
            bindtouchend="onRecordTouchEnd"
            bindtap="editStringingRecord"
          >
            <view class="stringing-main">
              <view class="stringing-title-row">
                <text class="stringing-name">{{item.stringName}}</text>
                <text class="stringing-tension">竖{{item.verticalTension || '-'}} / 横{{item.horizontalTension || '-'}}磅</text>
              </view>
              <text wx:if="{{item.storeName}}" class="stringing-store">{{item.storeName}}</text>
              <text class="stringing-meta">{{item.stringDate}}</text>
            </view>
            <text class="stringing-cost">¥{{item.cost}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty-text">暂无穿线记录</view>
    </view>
  </view>

</scroll-view>
