.profile-page {
  min-height: 100vh;
  padding: 34rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
  box-sizing: border-box;
  color: #05070c;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 38rpx 30rpx 34rpx;
}

.avatar-button {
  display: flex;
  width: 128rpx;
  height: 128rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  overflow: visible;
  border: 0;
  border-radius: 50%;
  background: transparent;
  box-shadow: none;
  line-height: 1;
}

.avatar-button::after {
  border: 0;
}

.avatar-button:active {
  opacity: 0.72;
}

.avatar-image,
.avatar-placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(13, 23, 40, 0.08);
  color: rgba(13, 23, 40, 0.42);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 128rpx;
}

.profile-title {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand {
  display: block;
  max-width: 100%;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-signature {
  display: block;
  max-width: 100%;
  color: rgba(13, 23, 40, 0.52);
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badges-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 14rpx;
}

.streak-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 120, 40, 0.14);
}

.streak-flame {
  font-size: 24rpx;
  line-height: 1;
}

.streak-text {
  color: #c15f1d;
  font-size: 24rpx;
  font-weight: 800;
}

.age-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(80, 203, 112, 0.14);
}

.age-icon {
  font-size: 24rpx;
  line-height: 1;
}

.age-text {
  color: #2f7d4f;
  font-size: 24rpx;
  font-weight: 800;
}

.content-card {
  padding: 30rpx 30rpx 28rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66);
}

.content-card + .content-card {
  margin-top: 22rpx;
}

.content-card:active {
  opacity: 0.86;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  color: rgba(13, 23, 40, 0.78);
  font-size: 28rpx;
  font-weight: 800;
}

.card-sub {
  color: rgba(13, 23, 40, 0.48);
  font-size: 22rpx;
  font-weight: 600;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat-cell {
  min-width: 0;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.42);
}

.stat-value-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stat-unit {
  flex: none;
  margin-left: 6rpx;
  color: rgba(13, 23, 40, 0.55);
  font-size: 22rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  margin-top: 10rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 22rpx;
  font-weight: 600;
}

.expense-eye {
  flex: none;
  margin-left: 10rpx;
  color: rgba(13, 23, 40, 0.42);
  font-size: 24rpx;
  font-weight: 800;
}

.gear-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.gear-total-label {
  color: rgba(13, 23, 40, 0.48);
  font-size: 22rpx;
  font-weight: 600;
}

.gear-total-value {
  color: #05070c;
  font-size: 34rpx;
  font-weight: 900;
}

.gear-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.42);
}

.gear-row:active {
  opacity: 0.72;
}

.gear-mark {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.gear-mark.t {
  background: rgba(77, 157, 246, 0.18);
}

.gear-mark.s {
  background: rgba(80, 203, 112, 0.18);
}

.racket-icon {
  position: relative;
  width: 44rpx;
  height: 52rpx;
}

.racket-head {
  position: absolute;
  top: 0;
  left: 50%;
  width: 40rpx;
  height: 34rpx;
  border: 5rpx solid #3778db;
  border-radius: 50%;
  box-sizing: border-box;
  transform: translateX(-50%);
}

.racket-string-v,
.racket-string-h {
  position: absolute;
  left: 50%;
  top: 50%;
  background: #3778db;
  transform: translate(-50%, -50%);
}

.racket-string-v {
  width: 2rpx;
  height: 22rpx;
}

.racket-string-h {
  width: 28rpx;
  height: 2rpx;
}

.racket-handle {
  position: absolute;
  top: 30rpx;
  left: 50%;
  width: 8rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: #3778db;
  transform: translateX(-50%);
}

.gear-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.gear-name {
  font-size: 28rpx;
  font-weight: 800;
}

.gear-sub {
  color: rgba(13, 23, 40, 0.52);
  font-size: 22rpx;
  font-weight: 600;
}

.gear-arrow {
  flex: none;
  color: rgba(13, 23, 40, 0.42);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 2rpx;
}

.menu-row + .menu-row {
  border-top: 1rpx solid rgba(13, 23, 40, 0.08);
}

.menu-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.menu-icon.user {
  background: rgba(55, 120, 219, 0.16);
}

.menu-icon.records {
  background: rgba(255, 201, 40, 0.22);
}

.menu-icon.feedback {
  background: rgba(43, 197, 216, 0.16);
}

.menu-icon.privacy {
  background: rgba(80, 203, 112, 0.18);
}

.menu-icon.settings {
  background: rgba(160, 170, 180, 0.22);
}

.menu-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-label {
  color: #05070c;
  font-size: 28rpx;
  font-weight: 800;
}

.menu-sub {
  color: rgba(13, 23, 40, 0.48);
  font-size: 22rpx;
  font-weight: 600;
}

.menu-arrow {
  flex: none;
  color: rgba(13, 23, 40, 0.42);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}
