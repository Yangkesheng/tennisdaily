.profile-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #f7f7f9;
  box-sizing: border-box;
  color: #05070c;
}

.card-hover,
.row-hover {
  opacity: 0.72;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 36rpx 30rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(13, 23, 40, 0.06);
}

.avatar-wrap {
  flex: none;
  width: 132rpx;
  height: 132rpx;
  padding: 6rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: linear-gradient(135deg, #3778db 0%, #6db3ff 100%);
}

.avatar-image,
.avatar-placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border-radius: 50%;
  background: #ffffff;
}

.avatar-image {
  overflow: hidden;
}

.avatar-placeholder {
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  line-height: 1;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-nickname {
  display: block;
  max-width: 100%;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-phone {
  display: block;
  margin-top: 8rpx;
  color: rgba(13, 23, 40, 0.46);
  font-size: 24rpx;
  font-weight: 700;
}

.identity-pills {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.identity-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(55, 120, 219, 0.08);
}

.identity-pill.accent {
  background: rgba(80, 203, 112, 0.1);
}

.pill-value {
  color: #3778db;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.identity-pill.accent .pill-value {
  color: #2f9e4f;
}

.pill-label {
  color: rgba(13, 23, 40, 0.52);
  font-size: 22rpx;
  font-weight: 700;
}

.row-arrow {
  flex: none;
  color: rgba(13, 23, 40, 0.28);
  font-size: 46rpx;
  font-weight: 400;
  line-height: 1;
}

.section-title {
  margin: 36rpx 8rpx 16rpx;
  color: rgba(13, 23, 40, 0.46);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(13, 23, 40, 0.05);
}

.equipment-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 30rpx;
}

.tile {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}

.tile.blue {
  background: #4d9df6;
}

.tile.green {
  background: #50cb70;
}

.equipment-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 800;
}

.equipment-metric {
  display: flex;
  align-items: flex-end;
}

.equipment-value {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}

.equipment-unit {
  margin-left: 8rpx;
  margin-bottom: 4rpx;
  color: rgba(13, 23, 40, 0.46);
  font-size: 22rpx;
  font-weight: 700;
}

.row-divider {
  height: 2rpx;
  margin: 0 30rpx;
  background: rgba(13, 23, 40, 0.06);
}

.equipment-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx 30rpx;
}

.equipment-total-label {
  color: rgba(13, 23, 40, 0.52);
  font-size: 26rpx;
  font-weight: 800;
}

.equipment-total-value {
  color: #3778db;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
}

.menu-label {
  font-size: 28rpx;
  font-weight: 800;
}

.footer-note {
  margin-top: 40rpx;
  text-align: center;
  color: rgba(13, 23, 40, 0.34);
  font-size: 22rpx;
  font-weight: 700;
}

.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  padding: 72rpx 30rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(13, 23, 40, 0.05);
}

.error-title {
  font-size: 30rpx;
  font-weight: 900;
}

.error-sub {
  color: rgba(13, 23, 40, 0.46);
  font-size: 24rpx;
  font-weight: 700;
}

.skeleton {
  border-radius: 32rpx;
  background: rgba(13, 23, 40, 0.07);
  animation: skeleton-pulse 1.2s ease-in-out infinite;
}

.skeleton-user-card {
  height: 220rpx;
}

.skeleton-line {
  width: 260rpx;
  height: 40rpx;
  margin-top: 36rpx;
}

.skeleton-card {
  height: 440rpx;
  margin-top: 20rpx;
}

@keyframes skeleton-pulse {
  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.45;
  }
}
