<navigation-bar title="我的" back="{{false}}" color="#05070c" background="transparent"></navigation-bar>
<scroll-view class="page profile-page" scroll-y type="list" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="skeleton skeleton-user-card"></view>
    <view class="skeleton skeleton-line"></view>
    <view class="skeleton skeleton-card"></view>
  </view>

  <view wx:elif="{{loadError}}" class="error-card" bindtap="retryLoad">
    <text class="error-title">加载失败</text>
    <text class="error-sub">点击重试</text>
  </view>

  <block wx:else>
    <view class="user-card" bindtap="goUserProfile" hover-class="card-hover">
      <view class="avatar-wrap">
        <image wx:if="{{user.avatarUrl}}" class="avatar-image" src="{{user.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder">🎾</view>
      </view>
      <view class="user-info">
        <text class="user-nickname">{{user.nickname || '网球爱好者'}}</text>
        <text class="user-phone">{{user.maskedPhone || '完善个人信息'}}</text>
        <view class="identity-pills">
          <view class="identity-pill">
            <text class="pill-value">{{sessionSummary.totalCount}}</text>
            <text class="pill-label">累计场次</text>
          </view>
          <view class="identity-pill accent">
            <text class="pill-value">{{sessionSummary.monthCount}}</text>
            <text class="pill-label">本月场次</text>
          </view>
        </view>
      </view>
      <text class="row-arrow">›</text>
    </view>

    <view class="section-title">我的装备</view>
    <view class="card equipment-card">
      <view class="equipment-row" bindtap="goRackets" hover-class="row-hover">
        <view class="tile blue">拍</view>
        <text class="equipment-name">球拍</text>
        <view class="equipment-metric">
          <text class="equipment-value">{{dashboard.racketCount}}</text>
          <text class="equipment-unit">把</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <view class="row-divider"></view>
      <view class="equipment-row" bindtap="goShoes" hover-class="row-hover">
        <view class="tile green">鞋</view>
        <text class="equipment-name">球鞋</text>
        <view class="equipment-metric">
          <text class="equipment-value">{{shoeDashboard.shoeCount}}</text>
          <text class="equipment-unit">双</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <view class="row-divider"></view>
      <view class="equipment-total">
        <text class="equipment-total-label">装备总投入</text>
        <text class="equipment-total-value">¥{{equipmentTotalText}}</text>
      </view>
    </view>

    <view class="card menu-card">
      <view class="menu-row" bindtap="goPrivacy" hover-class="row-hover">
        <text class="menu-label">隐私政策</text>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="footer-note">你的记录仅自己可见</view>
  </block>
</scroll-view>
