<navigation-bar title="" back="{{false}}" color="#fff" background="transparent"></navigation-bar>
<scroll-view class="page profile-page" scroll-y type="list">
  <view class="profile-header">
    <button class="avatar-button" bindtap="goUserProfile">
      <image wx:if="{{user.avatarUrl}}" class="avatar-image" src="{{user.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-placeholder">头像</view>
    </button>
    <view class="profile-title">
      <text class="brand">{{user.nickname || '我的'}}</text>
    </view>
    <view class="brand-line"></view>
  </view>

  <view class="dashboard-card" bindtap="goRackets">
    <view class="dashboard-row">
      <view>
        <text class="metric-label">球拍</text>
        <view class="metric-value-row">
          <text class="metric-value">{{dashboard.racketCount}}</text>
          <text class="metric-unit">把</text>
        </view>
      </view>
    </view>
    <view class="cost-list">
      <view class="cost-row">
        <text>球拍总消费</text>
        <text>¥{{dashboard.racketCostText}}</text>
      </view>
      <view class="cost-row">
        <text>穿线总消费</text>
        <text>¥{{dashboard.stringingCostText}}</text>
      </view>
    </view>
    <text class="enter-tip">查看球拍</text>
  </view>

  <view class="dashboard-card" bindtap="goShoes">
    <view class="dashboard-row">
      <view>
        <text class="metric-label">球鞋</text>
        <view class="metric-value-row">
          <text class="metric-value">{{shoeDashboard.shoeCount}}</text>
          <text class="metric-unit">双</text>
        </view>
      </view>
    </view>
    <view class="cost-list">
      <view class="cost-row">
        <text>球鞋总消费</text>
        <text>¥{{shoeDashboard.shoeCostText}}</text>
      </view>
    </view>
    <text class="enter-tip">查看球鞋</text>
  </view>
</scroll-view>
