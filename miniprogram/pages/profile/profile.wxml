<navigation-bar title="" back="{{false}}" color="#fff" background="transparent"></navigation-bar>
<scroll-view class="page profile-page" scroll-y type="list">
  <view class="profile-header">
    <button class="avatar-button" bindtap="goUserProfile">
      <image wx:if="{{user.avatarUrl}}" class="avatar-image" src="{{user.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-placeholder">头像</view>
    </button>
    <view class="profile-title">
      <text class="brand">{{user.nickname || '我的'}}</text>
    </view>
    <text wx:if="{{signature}}" class="profile-signature">{{signature}}</text>
    <view class="badges-row">
      <view wx:if="{{streakVisible}}" class="streak-badge">
        <text class="streak-flame">🔥</text>
        <text class="streak-text">已连续打球 {{streakDays}} 天</text>
      </view>
      <view wx:if="{{playingYearsText}}" class="age-badge">
        <text class="age-icon">🎾</text>
        <text class="age-text">球龄 {{playingYearsText}}</text>
      </view>
    </view>
  </view>

  <view class="content-card">
    <view class="card-head">
      <text class="card-title">我的坚持</text>
      <text class="card-sub">累计数据</text>
    </view>
    <view class="stats-grid">
      <view class="stat-cell">
        <view class="stat-value-row">
          <text class="stat-value">{{totalCount}}</text>
          <text class="stat-unit">次</text>
        </view>
        <text class="stat-label">累计场次</text>
      </view>
      <view class="stat-cell">
        <view class="stat-value-row">
          <text class="stat-value">{{totalHoursText}}</text>
          <text class="stat-unit">小时</text>
        </view>
        <text class="stat-label">累计时长</text>
      </view>
      <view class="stat-cell">
        <view class="stat-value-row">
          <text class="stat-value">{{isExpenseVisible ? totalCostText : '****'}}</text>
          <text class="stat-unit">元</text>
          <text class="expense-eye" catchtap="toggleExpenseVisible">{{isExpenseVisible ? '◉' : '◎'}}</text>
        </view>
        <text class="stat-label">累计花费</text>
      </view>
      <view class="stat-cell">
        <view class="stat-value-row">
          <text class="stat-value">{{championCount}}</text>
          <text class="stat-unit">次</text>
        </view>
        <text class="stat-label">冠军次数</text>
      </view>
    </view>
  </view>

  <view class="content-card gear-card">
    <view class="card-head">
      <text class="card-title">我的装备</text>
      <view class="gear-total">
        <text class="gear-total-label">总投入</text>
        <text class="gear-total-value">¥{{gearTotalCostText}}</text>
      </view>
    </view>
    <view class="gear-row" bindtap="goRackets">
      <view class="gear-mark t">
        <view class="racket-icon">
          <view class="racket-head">
            <view class="racket-string-v"></view>
            <view class="racket-string-h"></view>
          </view>
          <view class="racket-handle"></view>
        </view>
      </view>
      <view class="gear-copy">
        <text class="gear-name">球拍</text>
        <text class="gear-sub">{{dashboard.racketCount}} 把 · 含穿线 ¥{{dashboard.racketCostText}}</text>
      </view>
      <text class="gear-arrow">›</text>
    </view>
    <view class="gear-row" bindtap="goShoes">
      <view class="gear-mark s">👟</view>
      <view class="gear-copy">
        <text class="gear-name">球鞋</text>
        <text class="gear-sub">{{shoeDashboard.shoeCount}} 双 · ¥{{shoeDashboard.shoeCostText}}</text>
      </view>
      <text class="gear-arrow">›</text>
    </view>
  </view>

  <view class="content-card menu-card">
    <view class="menu-row" bindtap="goUserProfile">
      <text class="menu-icon user">👤</text>
      <view class="menu-copy">
        <text class="menu-label">个人信息</text>
        <text class="menu-sub">头像、昵称、退出登录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goRecords">
      <text class="menu-icon records">🏆</text>
      <view class="menu-copy">
        <text class="menu-label">个人记录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goFeedback">
      <text class="menu-icon feedback">💬</text>
      <view class="menu-copy">
        <text class="menu-label">意见反馈</text>
        <text class="menu-sub">告诉我们你的想法和建议</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goPrivacy">
      <text class="menu-icon privacy">🛡️</text>
      <view class="menu-copy">
        <text class="menu-label">隐私政策</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goSettings">
      <text class="menu-icon settings">⚙️</text>
      <view class="menu-copy">
        <text class="menu-label">设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</scroll-view>
