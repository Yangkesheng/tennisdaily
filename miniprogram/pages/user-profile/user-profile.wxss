.user-profile-page {
  min-height: 100vh;
  padding: 34rpx 28rpx calc(160rpx + env(safe-area-inset-bottom));
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
  box-sizing: border-box;
  color: #05070c;
}

.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 72rpx;
  padding: 46rpx 34rpx 34rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
}

.avatar-button {
  position: relative;
  display: flex;
  width: 152rpx;
  height: 152rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: rgba(13, 23, 40, 0.08);
  box-shadow: none;
  line-height: 1;
}

.avatar-button:active {
  opacity: 0.72;
}

.avatar-button.is-saving:active {
  opacity: 1;
}

.avatar-image,
.avatar-placeholder {
  position: absolute;
  inset: 0;
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(13, 23, 40, 0.08);
  color: rgba(13, 23, 40, 0.42);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 152rpx;
}

.info-list {
  width: 100%;
  margin-top: 42rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.62);
  box-sizing: border-box;
}

.save-button {
  width: 100%;
  height: 84rpx;
  margin-top: 20rpx;
  border-radius: 28rpx;
  background: #3778db;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.save-button::after {
  border: 0;
}

.save-button:active {
  opacity: 0.84;
}

.info-label {
  color: rgba(13, 23, 40, 0.52);
  font-size: 28rpx;
  font-weight: 800;
}

.info-value-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.info-value {
  max-width: 430rpx;
  color: #05070c;
  font-size: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-arrow {
  color: rgba(13, 23, 40, 0.32);
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1;
}

.nickname-popup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(5, 7, 12, 0.38);
}

.nickname-popup {
  width: 100%;
  padding: 34rpx 34rpx calc(42rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #f9f4ee;
  box-sizing: border-box;
}

.nickname-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.nickname-popup-title {
  color: #05070c;
  font-size: 34rpx;
  font-weight: 900;
}

.nickname-popup-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(13, 23, 40, 0.08);
  color: rgba(13, 23, 40, 0.56);
  font-size: 40rpx;
  font-weight: 500;
  line-height: 54rpx;
  text-align: center;
}

.nickname-popup-desc {
  display: block;
  margin-top: 16rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.nickname-popup-input {
  width: 100%;
  height: 88rpx;
  margin-top: 26rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #05070c;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}
.profile-footer {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.logout-button {
  width: 100%;
  height: 84rpx;
  margin-top: 24rpx;
  border-radius: 28rpx;
  background: rgba(13, 23, 40, 0.08);
  color: rgba(13, 23, 40, 0.68);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.logout-button::after {
  border: 0;
}

.logout-button:active {
  opacity: 0.84;
}
