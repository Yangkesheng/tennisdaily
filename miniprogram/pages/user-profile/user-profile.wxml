<navigation-bar title="个人信息" back="{{true}}" color="#05070c" background="transparent"></navigation-bar>
<scroll-view class="page user-profile-page" scroll-y type="list">
  <view class="profile-card">
    <view class="avatar-button {{isSavingAvatar ? 'is-saving' : ''}}" bindtap="onAvatarTap">
      <image wx:if="{{avatarSrc}}" class="avatar-image" src="{{avatarSrc}}" mode="aspectFill"></image>
      <view wx:else class="avatar-placeholder">头像</view>
    </view>
    <view class="info-list">
      <view class="info-row" bindtap="openNicknameEditor">
        <text class="info-label">昵称</text>
        <view class="info-value-row">
          <text class="info-value">{{user.nickname || 'yker'}}</text>
          <text class="info-arrow">›</text>
        </view>
      </view>
      <view class="info-row" bindtap="openSignatureEditor">
        <text class="info-label">个性签名</text>
        <view class="info-value-row">
          <text class="info-value">{{signature || '未设置'}}</text>
          <text class="info-arrow">›</text>
        </view>
      </view>
      <picker
        mode="multiSelector"
        range="{{[startYearOptions, startMonthOptions]}}"
        value="{{[startYearIndex, startMonthIndex]}}"
        bindcolumnchange="onStartDateColumnChange"
        bindchange="onStartDateChange"
      >
        <view class="info-row">
          <view class="info-label-group">
            <text class="info-label">开始打球时间</text>
            <text class="info-label-hint">用于计算球龄</text>
          </view>
          <view class="info-value-row">
            <text class="info-value">{{startDateText}}</text>
            <text class="info-arrow">›</text>
          </view>
        </view>
      </picker>
    </view>
  </view>
</scroll-view>

<view class="profile-footer">
  <button class="logout-button" bindtap="logout">退出登录</button>
</view>

<view wx:if="{{showNicknameEditor}}" class="nickname-popup-mask" bindtap="closeNicknameEditor">
  <view class="nickname-popup" catchtap="noop">
    <view class="nickname-popup-header">
      <text class="nickname-popup-title">修改昵称</text>
      <text class="nickname-popup-close" bindtap="closeNicknameEditor">×</text>
    </view>
    <text class="nickname-popup-desc">请输入昵称。</text>
    <input
      class="nickname-popup-input"
      type="text"
      value="{{nicknameDraft}}"
      placeholder="请输入昵称"
      maxlength="20"
      bindinput="onNicknameInput"
      bindblur="syncNicknameValue"
      bindconfirm="syncNicknameValue"
    />
    <button class="save-button" bindtap="saveNickname" loading="{{isSavingNickname}}" disabled="{{isSavingNickname}}">保存昵称</button>
  </view>
</view>

<view wx:if="{{showSignatureEditor}}" class="nickname-popup-mask" bindtap="closeSignatureEditor">
  <view class="nickname-popup" catchtap="noop">
    <view class="nickname-popup-header">
      <text class="nickname-popup-title">修改个性签名</text>
      <text class="nickname-popup-close" bindtap="closeSignatureEditor">×</text>
    </view>
    <text class="nickname-popup-desc">一句话介绍自己，最多 30 字。</text>
    <input
      class="nickname-popup-input"
      type="text"
      value="{{signatureDraft}}"
      placeholder="比如：底线抽球爱好者"
      maxlength="30"
      bindinput="onSignatureInput"
      bindblur="syncSignatureValue"
      bindconfirm="syncSignatureValue"
    />
    <button class="save-button" bindtap="saveSignature" loading="{{isSavingSignature}}" disabled="{{isSavingSignature}}">保存签名</button>
  </view>
</view>
