.list-page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
  background-attachment: fixed;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0 24rpx;
}

.list-header text {
  font-size: 42rpx;
  font-weight: 700;
}

.list-header button,
.empty-panel button {
  width: 76rpx;
  height: 76rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #1f7a4d;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.session-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.session-swipe {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  background: transparent;
}

.delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 150rpx;
  border-radius: 0 28rpx 28rpx 0;
  background: #e85d75;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.12s ease;
}

.session-item,
.empty-panel {
  position: relative;
  padding: 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  box-sizing: border-box;
  transition: transform 0.16s ease;
  will-change: transform;
}

.session-item:active {
  opacity: 0.78;
}

.session-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.session-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.session-date {
  font-size: 32rpx;
  font-weight: 700;
}

.session-type {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #e8f4ee;
  color: #1f7a4d;
  font-size: 22rpx;
  font-weight: 700;
}

.session-duration {
  color: #1f7a4d;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
}

.session-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  color: #607166;
  font-size: 26rpx;
}

.session-note {
  display: block;
  margin-top: 18rpx;
  color: #425047;
  font-size: 28rpx;
  line-height: 1.6;
}

.empty-panel {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  color: #607166;
  font-size: 48rpx;
  font-weight: 700;
}
