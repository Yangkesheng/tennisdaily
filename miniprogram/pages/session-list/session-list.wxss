.list-page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
  background-attachment: fixed;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0 24rpx;
}

.list-header text {
  font-size: 42rpx;
  font-weight: 700;
}

.list-header button,
.empty-panel button {
  width: 76rpx;
  height: 76rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #1f7a4d;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.pagination-card {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  margin-top: 22rpx;
  margin-bottom: 40rpx;
  padding: 0;
  box-sizing: border-box;
}

.pagination-line {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  max-width: 100%;
  padding: 0;
  box-sizing: border-box;
}

.page-nav {
  display: flex;
  align-items: center;
  gap: 24rpx;
  white-space: nowrap;
}

.page-current {
  color: #17251c;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 54rpx;
  white-space: nowrap;
}

.page-total,
.page-size-text {
  color: #607166;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 54rpx;
  white-space: nowrap;
}

.page-size-input {
  width: 78rpx;
  height: 54rpx;
  padding: 0 6rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.42);
  color: #17251c;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}

.page-arrow {
  min-width: 52rpx;
  padding: 0 10rpx;
  color: #3778db;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
  box-sizing: border-box;
}

.page-arrow.disabled {
  color: rgba(96, 113, 102, 0.36);
}

.session-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.session-swipe {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  background: transparent;
}

.delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 150rpx;
  border-radius: 0 28rpx 28rpx 0;
  background: #e85d75;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.12s ease;
}

.session-item,
.empty-panel {
  position: relative;
  padding: 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  box-sizing: border-box;
  transition: transform 0.16s ease;
  will-change: transform;
}

.session-item:active {
  opacity: 0.78;
}

.session-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.session-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.session-date {
  font-size: 32rpx;
  font-weight: 700;
}

.session-type {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.session-type.type-training {
  background: rgba(54, 179, 126, 0.14);
  color: #1f8f61;
}

.session-type.type-singles {
  background: rgba(55, 120, 219, 0.14);
  color: #2f6fcb;
}

.session-type.type-doubles {
  background: rgba(147, 92, 246, 0.14);
  color: #7c4fd6;
}

.session-type.type-singles-match {
  background: rgba(245, 158, 11, 0.16);
  color: #b96f00;
}

.session-type.type-doubles-match {
  background: rgba(232, 93, 117, 0.14);
  color: #cc4964;
}

.session-type.type-default {
  background: rgba(96, 113, 102, 0.12);
  color: #607166;
}

.session-duration {
  color: #1f7a4d;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
}

.session-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  color: #607166;
  font-size: 26rpx;
}

.session-note {
  display: block;
  margin-top: 18rpx;
  color: #425047;
  font-size: 28rpx;
  line-height: 1.6;
}

.empty-panel {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  color: #607166;
  font-size: 48rpx;
  font-weight: 700;
}
