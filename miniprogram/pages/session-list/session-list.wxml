<navigation-bar title="打球记录" back="{{true}}" color="#17251c" background="#f5f7f3"></navigation-bar>
<scroll-view class="page list-page" scroll-y type="list">
  <view class="list-header">
    <text>{{titleText}}</text>
    <text class="header-settings-icon" hover-class="header-settings-hover" bindtap="openDisplaySettings">⚙︎</text>
  </view>

  <view wx:if="{{sessions.length}}" class="session-list">
    <view wx:for="{{sessions}}" wx:key="id" class="session-swipe">
      <view class="delete-action" style="opacity: {{item.deleteOpacity}};" data-id="{{item.id}}" catchtap="confirmDeleteSession">删除</view>
      <view
        class="session-item"
        style="transform: translateX({{item.offsetX}}px);"
        data-id="{{item.id}}"
        bindtouchstart="onSwipeStart"
        bindtouchmove="onSwipeMove"
        bindtouchend="onSwipeEnd"
        bindtap="goEditSession"
      >
        <view class="session-topline">
          <view class="session-title-row">
            <text class="session-date">{{item.dateText}}</text>
            <text wx:if="{{item.showStartTime && item.startTimeText}}" class="session-start-time">{{item.startTimeText}}</text>
            <text class="session-type type-{{item.typeClass}}">{{item.typeLabel}}</text>
          </view>
          <text wx:if="{{item.showDuration}}" class="session-duration">{{item.durationMinutes}} 分钟</text>
        </view>
        <view class="session-meta" wx:if="{{item.showCourtName || item.showPartner || item.showRacketName || item.showShoeName || item.showCost}}">
          <text wx:if="{{item.courtName && item.showCourtName}}">{{item.courtName}}</text>
          <text wx:if="{{item.partner && item.showPartner}}">{{item.partner}}</text>
          <text wx:if="{{item.racketName && item.showRacketName}}">{{item.racketName}}</text>
          <text wx:if="{{item.shoeName && item.showShoeName}}">{{item.shoeName}}</text>
          <text wx:if="{{item.cost && item.showCost}}">¥{{item.cost}}</text>
        </view>
        <text wx:if="{{item.note && item.showNote}}" class="session-note">{{item.note}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!routeDateFilter}}" class="pagination-card">
    <view class="pagination-line">
      <view class="page-nav">
        <text class="page-arrow {{page <= 1 ? 'disabled' : ''}}" bindtap="goPrevPage">‹</text>
        <text class="page-current">第 {{page}}/{{totalPages || 1}} 页</text>
        <text class="page-arrow {{!hasMore ? 'disabled' : ''}}" bindtap="goNextPage">›</text>
      </view>
    </view>
    <view class="pagination-line">
      <text class="page-total">共 {{total}} 条</text>
      <text class="page-size-text">每页</text>
      <input class="page-size-input" value="{{pageSizeInput}}" type="number" bindinput="onPageSizeInput" bindconfirm="applyPageSize" bindblur="applyPageSize" />
      <text class="page-size-text">条</text>
    </view>
  </view>
</scroll-view>

<view wx:if="{{showDisplaySettings}}" class="settings-mask" catchtouchmove="noop" bindtap="closeDisplaySettings">
  <view class="settings-panel" catchtap="noop">
    <view class="settings-header">
      <text class="settings-title">列表展示字段</text>
      <text class="settings-subtitle">勾选后，列表卡片将显示对应信息，选择仅保存在本机</text>
    </view>
    <view class="settings-list">
      <view
        wx:for="{{displayFieldOptions}}"
        wx:key="key"
        class="settings-row"
        data-field="{{item.key}}"
        bindtap="onToggleDisplayField"
      >
        <text class="settings-row-label">{{item.label}}</text>
        <view class="settings-checkbox {{item.visible ? 'checked' : ''}}">
          <text wx:if="{{item.visible}}">✓</text>
        </view>
      </view>
    </view>
    <view class="settings-footer">
      <text class="settings-reset" bindtap="resetDisplayFields">恢复默认</text>
    </view>
  </view>
</view>
