.index-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(160deg, #cfd6ff 0%, #8fc3f7 46%, #eef5fb 100%);
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0 44rpx;
}

.title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.12;
}

.year {
  display: block;
  margin-top: 18rpx;
  color: rgba(13, 23, 40, 0.48);
  font-size: 32rpx;
  font-weight: 700;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stat-cell {
  min-width: 0;
  min-height: 136rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66);
  display: flex;
  align-items: center;
}

.stat-cell.tappable {
  transform: translateY(0);
}

.stat-cell.tappable:active {
  opacity: 0.78;
}

.stat-icon {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
}

.stat-copy {
  flex: 1;
  min-width: 0;
}

.stat-icon.cyan {
  background: #2bc5d8;
}

.stat-icon.yellow {
  background: #ffc928;
}

.stat-icon.blue {
  background: #4d9df6;
}

.stat-icon.green {
  background: #50cb70;
}

.stat-value {
  display: block;
  max-width: 100%;
  color: #05070c;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-label {
  display: block;
  max-width: 100%;
  margin-top: 6rpx;
  color: rgba(13, 23, 40, 0.42);
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-action {
  position: fixed;
  left: 50%;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #3778db;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 104rpx;
  text-align: center;
  transform: translateX(-50%);
  box-shadow: 0 20rpx 52rpx rgba(68, 112, 173, 0.28);
}
