.index-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(240rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
  background-attachment: fixed;
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0 44rpx;
}

.title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.12;
}

.year {
  display: block;
  margin-top: 18rpx;
  color: rgba(13, 23, 40, 0.48);
  font-size: 32rpx;
  font-weight: 700;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stat-cell {
  min-width: 0;
  min-height: 136rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66);
  display: flex;
  align-items: center;
}

.stat-cell.tappable:active {
  opacity: 0.78;
}

.stat-icon {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
}

.stat-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-icon.cyan {
  background: #2bc5d8;
}

.stat-icon.yellow {
  background: #ffc928;
}

.stat-icon.blue {
  background: #4d9df6;
}

.stat-icon.green {
  background: #50cb70;
}

.stat-value-wrap {
  display: flex;
  align-items: flex-end;
  max-width: 100%;
}

.stat-value {
  color: #05070c;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-unit {
  flex: none;
  margin-left: 6rpx;
  margin-bottom: 4rpx;
  color: #05070c;
  font-size: 24rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  max-width: 100%;
  margin-top: 6rpx;
  color: rgba(13, 23, 40, 0.42);
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  margin-top: 6rpx;
}

.stat-label-row .stat-label {
  margin-top: 0;
}

.expense-eye {
  flex: none;
  color: rgba(13, 23, 40, 0.48);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.expense-eye:active {
  opacity: 0.62;
}

.primary-racket-section {
  margin-top: 24rpx;
}

.primary-racket-tip {
  margin-top: 24rpx;
  min-height: 136rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  box-sizing: border-box;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.primary-racket-tip:active {
  opacity: 0.78;
}

.primary-tip-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: #3778db;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 64rpx;
  text-align: center;
}

.primary-tip-copy {
  flex: 1;
  min-width: 0;
}

.primary-tip-title {
  display: block;
  color: #05070c;
  font-size: 28rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary-tip-subtitle {
  display: block;
  margin-top: 8rpx;
  color: rgba(13, 23, 40, 0.46);
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary-tip-action {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(55, 120, 219, 0.1);
  color: #3778db;
  font-size: 22rpx;
  font-weight: 900;
}

.primary-racket-section:active {
  opacity: 0.78;
}

.racket-card {
  position: relative;
  width: 100%;
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  min-height: 240rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 28rpx;
  background: #fff;
  box-sizing: border-box;
}

.racket-mark {
  flex: none;
  width: 208rpx;
  height: 256rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.racket-image {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
}

.racket-mark text {
  max-width: 164rpx;
  color: rgba(13, 23, 40, 0.62);
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
}

.racket-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.racket-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  min-width: 0;
}

.racket-code {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.18;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  flex: none;
  min-width: 68rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.status-badge.primary {
  background: rgba(55, 120, 219, 0.76);
}

.racket-metric-grid {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.racket-metric {
  flex: 1;
  min-width: 0;
  padding: 10rpx 12rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(13, 23, 40, 0.03);
}

.racket-metric-value {
  display: block;
  color: #26313f;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.racket-metric-unit {
  display: inline-block;
  margin-left: 4rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.racket-metric-label {
  display: block;
  margin-top: 4rpx;
  color: rgba(13, 23, 40, 0.48);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
}

.stringing-panel {
  margin-top: 14rpx;
  padding: 12rpx 14rpx 11rpx;
  border-radius: 16rpx;
  background: rgba(80, 203, 112, 0.1);
  box-sizing: border-box;
}

.stringing-spec {
  display: block;
  color: rgba(13, 23, 40, 0.78);
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.12;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stringing-health-text {
  display: block;
  margin-top: 7rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.15;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stringing-health-segments {
  display: flex;
  gap: 6rpx;
  margin-top: 10rpx;
}

.stringing-health-segment {
  flex: 1;
  height: 12rpx;
  border-radius: 4rpx;
  background: rgba(13, 23, 40, 0.08);
}

.stringing-health-segment.on {
  background: rgba(31, 122, 77, 0.8);
}

.stringing-panel.health-fresh {
  background: rgba(80, 203, 112, 0.1);
}

.stringing-panel.health-fresh .stringing-health-text {
  color: rgba(31, 122, 77, 0.92);
}

.stringing-panel.health-peak {
  background: rgba(80, 203, 112, 0.1);
}

.stringing-panel.health-peak .stringing-health-text {
  color: rgba(31, 122, 77, 0.92);
}

.stringing-panel.health-good {
  background: rgba(45, 212, 191, 0.12);
}

.stringing-panel.health-good .stringing-health-text {
  color: rgba(13, 148, 136, 0.94);
}

.stringing-panel.health-good .stringing-health-segment.on {
  background: rgba(13, 148, 136, 0.85);
}

.stringing-panel.health-decline {
  background: rgba(251, 191, 36, 0.12);
}

.stringing-panel.health-decline .stringing-health-text {
  color: rgba(180, 83, 9, 0.94);
}

.stringing-panel.health-decline .stringing-health-segment.on {
  background: rgba(217, 119, 6, 0.85);
}

.stringing-panel.health-dead {
  background: rgba(251, 146, 60, 0.14);
}

.stringing-panel.health-dead .stringing-health-text {
  color: rgba(194, 65, 12, 0.94);
}

.stringing-panel.health-dead .stringing-health-segment.on {
  background: rgba(234, 88, 12, 0.88);
}

.stringing-panel.health-expired {
  background: rgba(248, 113, 113, 0.12);
}

.stringing-panel.health-expired .stringing-health-text {
  color: rgba(185, 28, 28, 0.94);
}

.stringing-panel.health-expired .stringing-health-segment.on {
  background: rgba(220, 38, 38, 0.88);
}

.empty-stringing-panel {
  background: rgba(13, 23, 40, 0.04);
}

.empty-stringing-line {
  display: block;
  color: rgba(13, 23, 40, 0.42);
  font-size: 23rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trend-card,
.recent-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
}

.card-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.card-section-title {
  flex: none;
  color: rgba(13, 23, 40, 0.6);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.card-section-subtitle {
  min-width: 0;
  color: #3778db;
  font-size: 26rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-section-date {
  min-width: 0;
  color: rgba(13, 23, 40, 0.35);
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.charts-board {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 10rpx;
}

.chart-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bar-value-box {
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.bar-value {
  color: #05070c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.bar-track {
  width: 100%;
  height: 110rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 36rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  transition: height 0.3s ease-in-out;
}

.bar.high {
  background: linear-gradient(180deg, #ffc928 0%, rgba(255, 201, 40, 0.4) 100%);
}

.bar.normal {
  background: linear-gradient(180deg, #4d9df6 0%, rgba(77, 157, 246, 0.4) 100%);
}

.bar.low {
  background: linear-gradient(180deg, #2bc5d8 0%, rgba(43, 197, 216, 0.4) 100%);
}

.bar-date {
  margin-top: 16rpx;
  color: rgba(13, 23, 40, 0.28);
  font-size: 20rpx;
  font-weight: 500;
}

.trend-empty {
  color: rgba(13, 23, 40, 0.42);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.recent-card:active {
  opacity: 0.78;
}

.recent-double-row-body {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 8rpx;
}

.recent-main-row {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}

.recent-duration-highlight {
  display: flex;
  align-items: flex-end;
}

.recent-duration-highlight .num {
  color: #05070c;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
}

.recent-duration-highlight .unit {
  margin-left: 6rpx;
  margin-bottom: 4rpx;
  color: rgba(13, 23, 40, 0.42);
  font-size: 22rpx;
  font-weight: 700;
}

.recent-type-tag {
  margin-bottom: 4rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #e8f4ee;
  color: #1f7a4d;
  font-size: 22rpx;
  font-weight: 700;
}

.recent-sub-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  min-width: 0;
}

.sub-item {
  max-width: 45%;
  color: rgba(13, 23, 40, 0.52);
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-content {
  color: #05070c;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.recent-login-button {
  width: auto;
  height: 64rpx;
  margin: 24rpx 0 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(55, 120, 219, 0.1);
  color: #3778db;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
}

.recent-login-button:active {
  opacity: 0.78;
}

.bottom-action {
  position: fixed;
  left: 50%;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #3778db;
  font-size: 60rpx;
  font-weight: 800;
  line-height: 102rpx;
  text-align: center;
  transform: translateX(-50%);
  box-shadow: 0 20rpx 52rpx rgba(68, 112, 173, 0.35);
  transition: transform 0.1s ease;
}

.bottom-action:active {
  opacity: 0.9;
  transform: translateX(-50%) scale(0.92);
}
