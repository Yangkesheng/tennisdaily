.index-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 150rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #cfd6ff 0%, #8fc3f7 46%, #eef5fb 100%);
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0 44rpx;
}

.title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.12;
}

.year {
  display: block;
  margin-top: 18rpx;
  color: rgba(13, 23, 40, 0.48);
  font-size: 32rpx;
  font-weight: 700;
}

.empty-panel button {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #3778db;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(68, 112, 173, 0.18);
}

.empty-panel button {
  color: #fff;
  background: #3778db;
}

.stats-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-cell {
  flex: none;
  width: calc(50% - 8rpx);
  min-width: 0;
  min-height: 136rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66);
  display: flex;
  align-items: center;
}

.stat-cell.tappable {
  transform: translateY(0);
}

.stat-cell.tappable:active {
  opacity: 0.78;
}

.stat-icon {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
}

.stat-copy {
  flex: 1;
  min-width: 0;
}

.stat-icon.cyan {
  background: #2bc5d8;
}

.stat-icon.yellow {
  background: #ffc928;
}

.stat-icon.blue {
  background: #4d9df6;
}

.stat-icon.green {
  background: #50cb70;
}

.stat-value {
  display: block;
  color: #05070c;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  color: rgba(13, 23, 40, 0.42);
  font-size: 24rpx;
  font-weight: 700;
}

.bottom-action {
  position: fixed;
  left: 50%;
  bottom: 140rpx;
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #3778db;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 104rpx;
  text-align: center;
  transform: translateX(-50%);
  box-shadow: 0 20rpx 52rpx rgba(68, 112, 173, 0.28);
}
