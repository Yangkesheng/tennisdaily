.index-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(240rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(160deg, #cfd6ff 0%, #8fc3f7 46%, #eef5fb 100%);
}

.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0 44rpx;
}

.title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.12;
}

.year {
  display: block;
  margin-top: 18rpx;
  color: rgba(13, 23, 40, 0.48);
  font-size: 32rpx;
  font-weight: 700;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stat-cell {
  min-width: 0;
  min-height: 136rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66);
  display: flex;
  align-items: center;
}

.stat-cell.tappable:active {
  opacity: 0.78;
}

.stat-icon {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
}

.stat-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-icon.cyan {
  background: #2bc5d8;
}

.stat-icon.yellow {
  background: #ffc928;
}

.stat-icon.blue {
  background: #4d9df6;
}

.stat-icon.green {
  background: #50cb70;
}

.stat-value-wrap {
  display: flex;
  align-items: flex-end;
  max-width: 100%;
}

.stat-value {
  color: #05070c;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-unit {
  flex: none;
  margin-left: 6rpx;
  margin-bottom: 4rpx;
  color: #05070c;
  font-size: 24rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  max-width: 100%;
  margin-top: 6rpx;
  color: rgba(13, 23, 40, 0.42);
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trend-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66);
}

.trend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.trend-title {
  flex: none;
  color: rgba(13, 23, 40, 0.6);
  font-size: 28rpx;
  font-weight: 700;
}

.trend-subtitle {
  min-width: 0;
  color: #3778db;
  font-size: 26rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.charts-board {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 10rpx;
}

.chart-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bar-value-box {
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.bar-value {
  color: #05070c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.bar-track {
  width: 100%;
  height: 110rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 36rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  transition: height 0.3s ease-in-out;
}

.bar.high {
  background: linear-gradient(180deg, #ffc928 0%, rgba(255, 201, 40, 0.4) 100%);
}

.bar.normal {
  background: linear-gradient(180deg, #4d9df6 0%, rgba(77, 157, 246, 0.4) 100%);
}

.bar.low {
  background: linear-gradient(180deg, #2bc5d8 0%, rgba(43, 197, 216, 0.4) 100%);
}

.bar-date {
  margin-top: 16rpx;
  color: rgba(13, 23, 40, 0.28);
  font-size: 20rpx;
  font-weight: 500;
}

.trend-empty {
  color: rgba(13, 23, 40, 0.42);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.recent-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66);
}

.recent-card:active {
  opacity: 0.78;
}

.recent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.recent-tag {
  flex: none;
  color: rgba(13, 23, 40, 0.6);
  font-size: 28rpx;
  font-weight: 700;
}

.recent-date {
  min-width: 0;
  color: rgba(13, 23, 40, 0.35);
  font-size: 22rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-body {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.recent-duration-box {
  display: flex;
  align-items: flex-end;
  min-width: 160rpx;
  margin-top: 4rpx;
}

.recent-duration {
  color: #05070c;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
}

.recent-unit {
  margin-left: 6rpx;
  margin-bottom: 4rpx;
  color: rgba(13, 23, 40, 0.42);
  font-size: 22rpx;
  font-weight: 700;
}

.recent-meta-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
  padding-left: 32rpx;
  border-left: 2rpx solid rgba(13, 23, 40, 0.06);
}

.recent-meta-item {
  display: flex;
  align-items: center;
  min-width: 0;
  font-size: 24rpx;
}

.meta-label {
  flex: none;
  margin-right: 16rpx;
  color: rgba(13, 23, 40, 0.3);
  font-weight: 700;
}

.meta-value {
  min-width: 0;
  color: rgba(13, 23, 40, 0.8);
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-content {
  color: #05070c;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.bottom-action {
  position: fixed;
  left: 50%;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  padding: 0;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #3778db;
  font-size: 60rpx;
  font-weight: 800;
  line-height: 102rpx;
  text-align: center;
  transform: translateX(-50%);
  box-shadow: 0 20rpx 52rpx rgba(68, 112, 173, 0.35);
  transition: transform 0.1s ease;
}

.bottom-action:active {
  opacity: 0.9;
  transform: translateX(-50%) scale(0.92);
}
