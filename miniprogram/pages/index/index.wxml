<navigation-bar title="" back="{{false}}" color="#0d1728" background="transparent"></navigation-bar>
<scroll-view class="page index-page" scroll-y type="list">
  <view class="hero">
    <view>
      <text class="title">网球</text>
      <text class="year">{{currentYear}}</text>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-cell">
      <view class="stat-icon yellow"></view>
      <view class="stat-copy">
        <view class="stat-value-wrap">
          <text class="stat-value">{{monthHoursText}}</text>
          <text class="stat-unit">小时</text>
        </view>
        <text class="stat-label">本月时长</text>
      </view>
    </view>
    <view class="stat-cell">
      <view class="stat-icon cyan"></view>
      <view class="stat-copy">
        <view class="stat-value-wrap">
          <text class="stat-value">{{stats.monthCount}}</text>
          <text class="stat-unit">次</text>
        </view>
        <text class="stat-label">本月</text>
      </view>
    </view>
    <view class="stat-cell">
      <view class="stat-icon green"></view>
      <view class="stat-copy">
        <view class="stat-value-wrap">
          <text class="stat-value">{{isExpenseVisible ? monthExpenseText : '****'}}</text>
          <text class="stat-unit">元</text>
        </view>
        <view class="stat-label-row">
          <text class="stat-label">本月花费</text>
          <text class="expense-eye" catchtap="toggleExpenseVisible">{{isExpenseVisible ? '◉' : '◎'}}</text>
        </view>
      </view>
    </view>
    <view class="stat-cell">
      <view class="stat-icon blue"></view>
      <view class="stat-copy">
        <view class="stat-value-wrap">
          <text class="stat-value">{{stats.yearCount}}</text>
          <text class="stat-unit">次</text>
        </view>
        <text class="stat-label">本年</text>
      </view>
    </view>
  </view>

  <view class="primary-racket-section" wx:if="{{primaryRacket}}" bindtap="goPrimaryRacket">
    <view class="racket-card">
      <view class="racket-mark">
        <image wx:if="{{primaryRacket.imageUrl}}" class="racket-image" src="{{primaryRacket.imageUrl}}" mode="aspectFit"></image>
        <text wx:else>{{primaryRacket.brand || 'T'}}</text>
      </view>
      <view class="racket-content">
        <view class="racket-status-row">
          <text class="racket-code">{{primaryRacket.identityText}}</text>
          <text class="status-badge primary">主力</text>
        </view>
        <view class="service-row">
          <text wx:if="{{primaryRacket.accompanyDaysText}}" class="service-days">已服役 {{primaryRacket.accompanyDaysText}}</text>
        </view>
        <view class="racket-metric-grid">
          <view class="racket-metric">
            <text class="racket-metric-value">{{primaryRacket.usageCount}}</text>
            <text class="racket-metric-label">场出战</text>
          </view>
          <view class="racket-metric">
            <text class="racket-metric-value">{{primaryRacket.usageHours}}</text>
            <text class="racket-metric-label">h陪伴</text>
          </view>
        </view>
        <view wx:if="{{primaryRacket.hasStringingInfo}}" class="stringing-panel health-{{primaryRacket.stringingHealthState}}">
          <text class="stringing-spec">{{primaryRacket.stringingSpecText || '未记录'}}</text>
          <block wx:if="{{primaryRacket.stringingHealthText}}">
            <text class="stringing-health-text">{{primaryRacket.stringingHealthText}}</text>
            <view class="stringing-health-segments">
              <view
                wx:for="{{primaryRacket.stringingHealthSegments}}"
                wx:key="key"
                class="stringing-health-segment {{item.on ? 'on' : ''}}"
              ></view>
            </view>
          </block>
        </view>
        <view wx:else class="stringing-panel empty-stringing-panel">
          <text class="empty-stringing-line">暂无穿线记录</text>
        </view>
      </view>
    </view>
  </view>

  <view class="primary-racket-tip" wx:elif="{{shouldShowPrimaryRacketTip}}" bindtap="goRackets">
    <view class="primary-tip-icon">T</view>
    <view class="primary-tip-copy">
      <text class="primary-tip-title">添加球拍或设置主力拍</text>
      <text class="primary-tip-subtitle">记录后首页会展示你的主力球拍</text>
    </view>
    <text class="primary-tip-action">去设置</text>
  </view>

  <view class="trend-card">
    <view class="card-section-header">
      <text class="card-section-title">近几场手感</text>
      <text class="card-section-subtitle">{{ratingTrendText}}</text>
    </view>
    <view wx:if="{{ratingTrend.length}}" class="charts-board">
      <view wx:for="{{ratingTrend}}" wx:key="key" class="chart-column">
        <view class="bar-value-box">
          <text class="bar-value">{{item.rating}}</text>
        </view>
        <view class="bar-track">
          <view class="bar {{item.level}}" style="height: {{item.height}}rpx;"></view>
        </view>
        <text class="bar-date">{{item.dateText}}</text>
      </view>
    </view>
    <view wx:else class="trend-empty">记录几场后，这里会展示手感趋势</view>
  </view>

  <view class="recent-card" bindtap="goSessionList">
    <view class="card-section-header">
      <text class="card-section-title">最近打球</text>
      <text class="card-section-date">{{latestSession ? latestSession.date : '暂无'}}</text>
    </view>
    <view wx:if="{{latestSession}}" class="recent-double-row-body">
      <view class="recent-main-row">
        <view class="recent-duration-highlight">
          <text class="num">{{latestSession.durationMinutes}}</text>
          <text class="unit">分钟</text>
        </view>
        <text class="recent-type-tag">{{latestSession.typeLabel}}</text>
      </view>
      <view class="recent-sub-row">
        <text class="sub-item" wx:if="{{latestSession.courtName}}">{{latestSession.courtName}}</text>
        <text class="sub-item" wx:if="{{latestSession.racketName}}">{{latestSession.racketName}}</text>
        <text class="sub-item" wx:if="{{latestSession.shoeName}}">{{latestSession.shoeName}}</text>
      </view>
    </view>
    <text wx:else class="recent-content">{{latestSessionSummary}}</text>
    <button wx:if="{{!isLoggedIn}}" class="recent-login-button" catchtap="goLogin">登录同步记录</button>
  </view>

  <button class="bottom-action" bindtap="goCreateSession">+</button>
</scroll-view>
