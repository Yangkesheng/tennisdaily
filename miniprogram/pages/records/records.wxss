.records-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
  box-sizing: border-box;
  color: #05070c;
}

.records-loading,
.records-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 160rpx 40rpx;
}

.records-loading-text,
.records-error-text {
  color: rgba(13, 23, 40, 0.52);
  font-size: 28rpx;
  font-weight: 600;
}

.records-retry-button {
  width: 240rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: #3778db;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
}

.streak-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx 36rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66);
}

.streak-flame {
  font-size: 56rpx;
  line-height: 1;
}

.streak-value-row {
  display: flex;
  align-items: flex-end;
  margin-top: 18rpx;
}

.streak-value {
  font-size: 96rpx;
  font-weight: 900;
  line-height: 1;
}

.streak-unit {
  margin-left: 10rpx;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.streak-label {
  margin-top: 14rpx;
  color: #05070c;
  font-size: 28rpx;
  font-weight: 800;
}

.streak-tip {
  margin-top: 10rpx;
  color: rgba(13, 23, 40, 0.48);
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.records-card {
  margin-top: 22rpx;
  padding: 30rpx 30rpx 26rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.66);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  color: rgba(13, 23, 40, 0.78);
  font-size: 28rpx;
  font-weight: 800;
}

.record-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.42);
}

.record-row.tappable:active {
  opacity: 0.72;
}

.record-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.record-icon.clock {
  background: rgba(77, 157, 246, 0.16);
}

.record-icon.month {
  background: rgba(43, 197, 216, 0.16);
}

.record-icon.sessions {
  background: rgba(80, 203, 112, 0.18);
}

.record-icon.streak {
  background: rgba(255, 120, 40, 0.16);
}

.record-icon.cost {
  background: rgba(255, 80, 80, 0.14);
}

.record-icon.champion {
  background: rgba(255, 201, 40, 0.22);
}

.record-icon.runnerup {
  background: rgba(160, 170, 180, 0.22);
}

.record-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-label {
  color: rgba(13, 23, 40, 0.52);
  font-size: 22rpx;
  font-weight: 600;
}

.record-value {
  color: #05070c;
  font-size: 30rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-detail {
  color: rgba(13, 23, 40, 0.48);
  font-size: 24rpx;
  font-weight: 600;
}

.record-arrow {
  flex: none;
  color: rgba(13, 23, 40, 0.42);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 20rpx;
}

.summary-cell {
  min-width: 0;
  padding: 26rpx 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.42);
}

.summary-value-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.summary-value {
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.summary-unit {
  margin-left: 6rpx;
  color: rgba(13, 23, 40, 0.55);
  font-size: 22rpx;
  font-weight: 700;
}

.summary-label {
  display: block;
  margin-top: 10rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 22rpx;
  font-weight: 600;
}

.summary-eye {
  color: rgba(13, 23, 40, 0.42);
  font-size: 24rpx;
  font-weight: 800;
}
