.library-page {
  min-height: 100vh;
  height: 100vh;
  padding: 20rpx 16rpx 0;
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
  background-attachment: fixed;
  color: #05070c;
  box-sizing: border-box;
}

.nav-title {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #05070c;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.nav-brand-name {
  max-width: 180rpx;
  height: 48rpx;
  margin-left: 14rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(55, 120, 219, 0.12);
  color: #3778db;
  font-size: 26rpx;
  line-height: 48rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.library-body {
  display: flex;
  height: calc(100vh - 72rpx);
  min-height: 0;
}

.brand-sidebar {
  flex: none;
  width: 116rpx;
  height: 100%;
  padding-right: 12rpx;
  box-sizing: border-box;
}

.brand-item {
  min-height: 76rpx;
  padding: 14rpx 0;
  color: rgba(13, 23, 40, 0.62);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
  word-break: break-word;
  box-sizing: border-box;
}

.brand-item.active,
.manual-brand {
  color: #3778db;
}

.manual-brand {
  margin-top: 10rpx;
}

.product-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-width: 0;
  border-radius: 24rpx 24rpx 0 0;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
}

.series-tabs {
  flex: none;
  width: 100%;
  height: 82rpx;
  white-space: nowrap;
}

.series-list {
  display: inline-flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 18rpx 18rpx 8rpx;
  box-sizing: border-box;
}

.series-chip {
  height: 48rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.54);
  color: rgba(13, 23, 40, 0.52);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.series-chip.active {
  background: #3778db;
  color: #ffffff;
}

.product-scroll {
  flex: 1;
  min-height: 0;
}

.product-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 24rpx 18rpx 80rpx;
  box-sizing: border-box;
}

.product-card {
  width: 50%;
  min-height: 258rpx;
  padding: 10rpx;
  box-sizing: border-box;
}

.product-image-wrap {
  height: 174rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.42);
}

.product-image {
  width: 220rpx;
  height: 148rpx;
}

.product-mark {
  width: 150rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.62);
  color: rgba(13, 23, 40, 0.58);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 96rpx;
  text-align: center;
}

.product-name {
  display: block;
  margin-top: 16rpx;
  color: rgba(13, 23, 40, 0.62);
  font-size: 25rpx;
  font-weight: 800;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-library {
  height: 300rpx;
  color: rgba(13, 23, 40, 0.45);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 300rpx;
  text-align: center;
}
