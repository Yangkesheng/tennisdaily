.edit-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
}

.edit-scroll {
  flex: 1;
  min-height: 0;
}

.edit-content {
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.edit-hero {
  padding: 26rpx 0 44rpx;
}

.edit-title {
  display: block;
  color: #05070c;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.12;
}

.field-group {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  margin-bottom: 16rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 26rpx;
  font-weight: 700;
}

.picker-value,
.input-card {
  min-height: 92rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  box-sizing: border-box;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
}

.picker-value {
  color: #17251c;
  font-size: 32rpx;
  line-height: 44rpx;
}

.choice-options {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
}

.type-options,
.rank-options {
  flex-wrap: nowrap;
}

.type-options .choice-option,
.rank-options .choice-option {
  flex: 1;
  width: auto;
  font-size: 22rpx;
  border-radius: 20rpx;
}

.choice-option {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  color: #40506a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 84rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
}

.choice-option.active {
  background: #3778db;
  color: #fff;
}

.custom-duration-card {
  margin-top: 14rpx;
}

.rating-group {
  margin-top: -8rpx;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.rating-card {
  min-height: 110rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  box-sizing: border-box;
}

.stars-container {
  flex: none;
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.star-box {
  flex: none;
  width: 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
}

.star-char {
  display: inline-block;
  color: rgba(13, 23, 40, 0.15);
  font-size: 40rpx;
}

.star-char.active {
  color: #ffc928;
  text-shadow: 0 2rpx 8rpx rgba(255, 201, 40, 0.22);
}

.rating-tips {
  flex: 1;
  min-width: 120rpx;
  color: rgba(13, 23, 40, 0.5);
  font-size: 24rpx;
  font-weight: 700;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.input-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.input-card text {
  flex: none;
  width: 96rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 26rpx;
  font-weight: 700;
}

.input-card input,
.picker-inline {
  flex: 1;
  min-width: 0;
  color: #17251c;
  font-size: 30rpx;
}

.bottom-action-area {
  flex-shrink: 0;
  padding: 24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(238, 214, 202, 0) 0%, rgba(238, 214, 202, 0.95) 100%);
  box-sizing: border-box;
}

.submit-button {
  width: 100%;
  height: 96rpx;
  margin-top: 0;
  border-radius: 48rpx;
  background: #3778db;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 96rpx;
  box-shadow: 0 8rpx 24rpx rgba(55, 120, 219, 0.3);
}
