<navigation-bar title="{{titleText}}" back="{{true}}" color="#0d1728" background="transparent"></navigation-bar>
<view class="page edit-page">
  <scroll-view class="edit-scroll" scroll-y>
    <view class="edit-content">
      <view class="edit-hero">
        <text class="edit-title">{{titleText}}</text>
      </view>

  <view class="field-group">
    <text class="field-label">日期</text>
    <picker mode="date" value="{{draft.date}}" bindchange="onDateChange">
      <view class="picker-value">{{draft.date}}</view>
    </picker>
  </view>

  <view class="field-group rating-group">
    <text class="field-label">今日手感</text>
    <view class="rating-card">
      <view class="stars-container">
        <view class="star-box" data-rating="1" bindtap="selectRating">
          <text class="star-char {{draft.rating >= 1 ? 'active' : ''}}">★</text>
        </view>
        <view class="star-box" data-rating="2" bindtap="selectRating">
          <text class="star-char {{draft.rating >= 2 ? 'active' : ''}}">★</text>
        </view>
        <view class="star-box" data-rating="3" bindtap="selectRating">
          <text class="star-char {{draft.rating >= 3 ? 'active' : ''}}">★</text>
        </view>
        <view class="star-box" data-rating="4" bindtap="selectRating">
          <text class="star-char {{draft.rating >= 4 ? 'active' : ''}}">★</text>
        </view>
        <view class="star-box" data-rating="5" bindtap="selectRating">
          <text class="star-char {{draft.rating >= 5 ? 'active' : ''}}">★</text>
        </view>
      </view>
      <text class="rating-tips">{{ratingText}}</text>
    </view>
  </view>

  <view class="field-group">
    <text class="field-label">类型</text>
    <view class="choice-options type-options">
      <button class="choice-option {{draft.type === 'doubles' ? 'active' : ''}}" data-type="doubles" bindtap="selectType">双打</button>
      <button class="choice-option {{draft.type === 'singles' ? 'active' : ''}}" data-type="singles" bindtap="selectType">单打</button>
      <button class="choice-option {{draft.type === 'training' ? 'active' : ''}}" data-type="training" bindtap="selectType">训练</button>
      <button class="choice-option {{draft.type === 'singlesMatch' ? 'active' : ''}}" data-type="singlesMatch" bindtap="selectType">单打比赛</button>
      <button class="choice-option {{draft.type === 'doublesMatch' ? 'active' : ''}}" data-type="doublesMatch" bindtap="selectType">双打比赛</button>
    </view>
  </view>

  <view wx:if="{{isMatchType}}" class="field-group">
    <text class="field-label">成绩</text>
    <view class="choice-options rank-options">
      <button class="choice-option {{draft.matchRank === 'champion' ? 'active' : ''}}" data-rank="champion" bindtap="selectMatchRank">冠军</button>
      <button class="choice-option {{draft.matchRank === 'runnerUp' ? 'active' : ''}}" data-rank="runnerUp" bindtap="selectMatchRank">亚军</button>
      <button class="choice-option {{draft.matchRank === 'semiFinal' ? 'active' : ''}}" data-rank="semiFinal" bindtap="selectMatchRank">四强</button>
      <button class="choice-option {{draft.matchRank === 'quarterFinal' ? 'active' : ''}}" data-rank="quarterFinal" bindtap="selectMatchRank">八强</button>
      <button class="choice-option {{draft.matchRank === 'groupStage' ? 'active' : ''}}" data-rank="groupStage" bindtap="selectMatchRank">小组赛</button>
    </view>
  </view>

  <view class="field-group">
    <text class="field-label">时长（分钟）</text>
    <view class="choice-options">
      <button class="choice-option {{!isCustomDuration && draft.durationMinutes === 60 ? 'active' : ''}}" bindtap="selectSixtyMinutes">60</button>
      <button class="choice-option {{!isCustomDuration && draft.durationMinutes === 120 ? 'active' : ''}}" bindtap="selectOneTwentyMinutes">120</button>
      <button class="choice-option {{isCustomDuration ? 'active' : ''}}" bindtap="showCustomDuration">自定义</button>
    </view>
    <view wx:if="{{isCustomDuration}}" class="input-card custom-duration-card">
      <text>分钟</text>
      <input value="{{customDuration}}" type="number" placeholder="90" bindinput="onDurationInput" />
    </view>
  </view>

  <view class="field-grid">
    <view class="input-card">
      <text>场地</text>
      <input value="{{draft.courtName}}" placeholder="球场" bindinput="onCourtInput" />
    </view>
    <view class="input-card">
      <text>花费</text>
      <input value="{{costInput}}" type="digit" placeholder="0" bindinput="onCostInput" />
    </view>
    <picker range="{{racketNames}}" value="{{racketPickerIndex}}" bindchange="onRacketChange">
      <view class="input-card">
        <text>球拍</text>
        <view class="picker-inline">{{draft.racketName || '选择球拍'}}</view>
      </view>
    </picker>
    <view class="input-card">
      <text>球鞋</text>
      <input value="{{draft.shoeName}}" placeholder="球鞋" bindinput="onShoeInput" />
    </view>
    <view class="input-card">
      <text>搭档</text>
      <input value="{{draft.partner}}" placeholder="搭档姓名，可不填" bindinput="onPartnerInput" />
    </view>
  </view>

    </view>
  </scroll-view>

  <view class="bottom-action-area">
    <button class="submit-button" bindtap="submitSession">保存</button>
  </view>
</view>
