<navigation-bar title="{{titleText}}" back="{{true}}" color="#0d1728" background="transparent"></navigation-bar>
<view class="page edit-page">
  <scroll-view class="edit-scroll" scroll-y>
    <view class="edit-content">
      <view class="edit-hero">
        <text class="edit-title">{{titleText}}</text>
      </view>

  <view class="field-group">
    <text class="field-label">开始时间（日期 / 小时 / 分钟）</text>
    <view class="datetime-inline">
      <picker class="datetime-picker date-picker" mode="date" value="{{startDate}}" bindchange="onDateChange">
        <view class="picker-value datetime-pill date-pill">{{startDate}}</view>
      </picker>
      <picker class="datetime-picker hour-picker" mode="selector" range="{{hourOptions}}" value="{{hourIndex}}" bindchange="onHourChange">
        <view class="picker-value datetime-pill hour-pill">{{hourOptions[hourIndex]}}</view>
      </picker>
      <view class="minute-input-inline">
        <input value="{{minuteInput}}" type="number" maxlength="2" placeholder="00" bindinput="onMinuteInput" />
        <picker class="minute-quick-trigger" mode="selector" range="{{minuteOptions}}" value="{{minuteIndex}}" bindchange="onMinuteChange">
          <view class="minute-arrow">▾</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="field-group">
    <text class="field-label">时长（小时）</text>
    <view class="choice-options duration-options">
      <button class="choice-option {{!isCustomDuration && draft.durationMinutes === 60 ? 'active' : ''}}" bindtap="selectSixtyMinutes">1</button>
      <button class="choice-option {{!isCustomDuration && draft.durationMinutes === 120 ? 'active' : ''}}" bindtap="selectOneTwentyMinutes">2</button>
      <button class="choice-option {{!isCustomDuration && draft.durationMinutes === 180 ? 'active' : ''}}" bindtap="selectThreeHours">3</button>
      <view class="duration-custom-card {{isCustomDuration ? 'active' : ''}}">
        <input value="{{customDuration}}" type="number" placeholder="自定义" bindinput="onDurationInput" />
      </view>
    </view>
  </view>

  <view class="field-group">
    <text class="field-label">类型</text>
    <view class="choice-options type-options">
      <button wx:for="{{categoryOptions}}" wx:key="value" class="choice-option {{draft.category === item.value ? 'active' : ''}}" data-category="{{item.value}}" bindtap="selectCategory">{{item.label}}</button>
    </view>
  </view>

  <view class="field-group">
    <text class="field-label">具体类型</text>
    <view class="choice-options type-options">
      <button wx:for="{{subCategoryOptions}}" wx:key="value" class="choice-option {{draft.subCategory === item.value ? 'active' : ''}}" data-sub-category="{{item.value}}" bindtap="selectSubCategory">{{item.label}}</button>
    </view>
  </view>

  <view wx:if="{{isMatchType}}" class="field-group">
    <text class="field-label">成绩</text>
    <view class="choice-options rank-options">
      <button wx:for="{{matchRankOptions}}" wx:key="value" class="choice-option {{draft.matchRank === item.value ? 'active' : ''}}" data-rank="{{item.value}}" bindtap="selectMatchRank">{{item.label}}</button>
    </view>
  </view>

  <view class="field-grid">
    <view class="input-card">
      <text>场地</text>
      <input value="{{draft.courtName}}" placeholder="球场" bindinput="onCourtInput" />
    </view>
    <view class="input-card">
      <text>花费</text>
      <input value="{{costInput}}" type="digit" placeholder="0" bindinput="onCostInput" />
    </view>
    <picker range="{{racketNames}}" value="{{racketPickerIndex}}" bindchange="onRacketChange">
      <view class="input-card">
        <text>球拍</text>
        <view class="picker-inline">{{draft.racketName || '选择球拍'}}</view>
      </view>
    </picker>
    <picker range="{{shoeNames}}" value="{{shoePickerIndex}}" bindchange="onShoeChange">
      <view class="input-card">
        <text>球鞋</text>
        <view class="picker-inline">{{draft.shoeName || '选择球鞋'}}</view>
      </view>
    </picker>
    <view class="input-card">
      <text>搭档</text>
      <input value="{{draft.partner}}" placeholder="搭档姓名，可不填" bindinput="onPartnerInput" />
    </view>
  </view>

  <view class="field-group rating-group">
    <text class="field-label">今日手感</text>
    <view class="rating-card">
      <view class="stars-container">
        <view class="star-box" data-rating="1" bindtap="selectRating">
          <text class="star-char {{draft.rating >= 1 ? 'active' : ''}}">★</text>
        </view>
        <view class="star-box" data-rating="2" bindtap="selectRating">
          <text class="star-char {{draft.rating >= 2 ? 'active' : ''}}">★</text>
        </view>
        <view class="star-box" data-rating="3" bindtap="selectRating">
          <text class="star-char {{draft.rating >= 3 ? 'active' : ''}}">★</text>
        </view>
        <view class="star-box" data-rating="4" bindtap="selectRating">
          <text class="star-char {{draft.rating >= 4 ? 'active' : ''}}">★</text>
        </view>
        <view class="star-box" data-rating="5" bindtap="selectRating">
          <text class="star-char {{draft.rating >= 5 ? 'active' : ''}}">★</text>
        </view>
      </view>
      <text class="rating-tips">{{ratingText}}</text>
    </view>
  </view>

    </view>
  </scroll-view>

  <view class="bottom-action-area">
    <button class="submit-button" loading="{{saving}}" disabled="{{saving}}" bindtap="submitSession">保存</button>
  </view>
</view>
