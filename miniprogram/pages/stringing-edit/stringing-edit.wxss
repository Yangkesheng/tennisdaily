.stringing-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
}

.stringing-scroll {
  flex: 1;
  min-height: 0;
}

.stringing-content {
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
}

.edit-hero {
  padding: 26rpx 0 44rpx;
}

.edit-title {
  display: block;
  color: #05070c;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.12;
}

.racket-name {
  display: block;
  margin-top: 14rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 28rpx;
  font-weight: 800;
}

.field-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.input-card {
  min-height: 92rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.55);
  box-sizing: border-box;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.input-card text {
  flex: none;
  width: 128rpx;
  color: rgba(13, 23, 40, 0.52);
  font-size: 26rpx;
  font-weight: 700;
}

.tension-inline {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

.tension-input-wrap {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 29rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.78);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tension-input-wrap .tension-label {
  width: auto;
  color: rgba(13, 23, 40, 0.48);
  font-size: 24rpx;
}

.tension-input-wrap input {
  flex: 1;
  min-width: 0;
  color: #17251c;
  font-size: 30rpx;
  font-weight: 800;
  text-align: right;
}

.stringing-time-card text {
  width: 128rpx;
}

.datetime-inline {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.datetime-picker {
  flex: none;
}

.datetime-pill {
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #17251c;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.78);
}

.date-pill {
  min-width: 190rpx;
}

.hour-pill {
  min-width: 74rpx;
  padding: 0 16rpx;
}

.time-picker {
  min-width: 74rpx;
}

.input-card input,
.picker-inline {
  flex: 1;
  min-width: 0;
  color: #17251c;
  font-size: 30rpx;
  text-align: right;
}

.bottom-action-area {
  flex-shrink: 0;
  padding: 24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(238, 214, 202, 0) 0%, rgba(238, 214, 202, 0.95) 100%);
  box-sizing: border-box;
}

.submit-button {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: #3778db;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 96rpx;
  box-shadow: 0 8rpx 24rpx rgba(55, 120, 219, 0.3);
}
