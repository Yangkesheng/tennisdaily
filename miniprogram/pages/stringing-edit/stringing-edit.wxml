<navigation-bar title="穿线" back="{{true}}" color="#05070c" background="transparent"></navigation-bar>
<view class="page stringing-page">
  <scroll-view class="stringing-scroll" scroll-y>
    <view class="stringing-content">
      <view class="edit-hero">
        <text class="edit-title">穿线</text>
        <text class="racket-name">{{racketName}}</text>
      </view>

      <view class="field-grid">
        <view class="input-card">
          <text>球线</text>
          <input value="{{draft.stringName}}" placeholder="Poly Tour Pro" bindinput="onStringNameInput" />
        </view>
        <view class="input-card">
          <text>磅数</text>
          <input value="{{draft.tension}}" type="digit" placeholder="48" bindinput="onTensionInput" />
        </view>
        <picker mode="date" value="{{draft.stringDate}}" bindchange="onDateChange">
          <view class="input-card">
            <text>日期</text>
            <view class="picker-inline">{{draft.stringDate}}</view>
          </view>
        </picker>
        <view class="input-card">
          <text>花费</text>
          <input value="{{draft.cost}}" type="digit" placeholder="0" bindinput="onCostInput" />
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-action-area">
    <button class="submit-button" loading="{{saving}}" bindtap="submitStringing">保存</button>
  </view>
</view>

