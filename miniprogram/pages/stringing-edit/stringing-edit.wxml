<navigation-bar title="{{pageTitle}}" back="{{true}}" color="#05070c" background="transparent"></navigation-bar>
<view class="page stringing-page">
  <scroll-view class="stringing-scroll" scroll-y>
    <view class="stringing-content">
      <view class="edit-hero">
        <text class="edit-title">{{pageTitle}}</text>
        <text class="racket-name">{{racketName}}</text>
      </view>

      <view class="field-grid">
        <view class="input-card">
          <text>球线名称</text>
          <input value="{{draft.stringName}}" placeholder="Poly Tour Pro" bindinput="onStringNameInput" />
        </view>
        <view class="input-card">
          <text>穿线地点</text>
          <input value="{{draft.storeName}}" placeholder="可不填" bindinput="onStoreNameInput" />
        </view>
        <view class="input-card tension-card">
          <text>磅数</text>
          <view class="tension-inline">
            <view class="tension-input-wrap">
              <text class="tension-label">竖</text>
              <input value="{{verticalTensionText}}" type="digit" placeholder="0" bindinput="onVerticalTensionInput" />
            </view>
            <view class="tension-input-wrap">
              <text class="tension-label">横</text>
              <input value="{{horizontalTensionText}}" type="digit" placeholder="0" bindinput="onHorizontalTensionInput" />
            </view>
          </view>
        </view>
        <view class="input-card stringing-time-card">
          <text>穿线时间</text>
          <view class="datetime-inline">
            <picker class="datetime-picker" mode="date" value="{{draft.stringDate}}" bindchange="onDateChange">
              <view class="datetime-pill date-pill">{{draft.stringDate}}</view>
            </picker>
            <picker class="datetime-picker time-picker" mode="selector" range="{{hourOptions}}" value="{{hourIndex}}" bindchange="onTimeChange">
              <view class="datetime-pill hour-pill">{{draft.stringTime}}点</view>
            </picker>
          </view>
        </view>
        <view class="input-card">
          <text>花费</text>
          <input value="{{costText}}" type="digit" placeholder="0" bindinput="onCostInput" />
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-action-area">
    <button class="submit-button" loading="{{saving}}" disabled="{{saving}}" bindtap="submitStringing">保存</button>
  </view>
</view>
