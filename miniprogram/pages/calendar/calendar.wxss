.calendar-page {
  min-height: 100vh;
  padding: 28rpx 32rpx 56rpx;
  background: #f7f7f9;
  box-sizing: border-box;
}

.panel-handle {
  width: 92rpx;
  height: 12rpx;
  margin: 0 auto 34rpx;
  border-radius: 999rpx;
  background: #d7dbe3;
}

.calendar-head,
.calendar-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.calendar-head {
  margin-bottom: 52rpx;
}

.calendar-tabs {
  display: flex;
  align-items: flex-end;
  gap: 38rpx;
}

.muted-tab {
  color: #a8aab0;
  font-size: 36rpx;
  font-weight: 700;
}

.active-tab {
  position: relative;
  color: #05070c;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1;
}

.active-tab::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: -14rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #4b88eb;
}

.calendar-summary {
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
  color: #05070c;
  font-size: 36rpx;
  font-weight: 800;
}

.active-count {
  text-align: right;
}

.month-switcher {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
}

.month-current {
  min-width: 168rpx;
  color: #7b808a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: left;
}

.month-nav {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #eef2f8;
  color: #3f82e8;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.month-nav-active {
  opacity: 0.72;
}

.months {
  display: block;
}

.month-card {
  width: 100%;
  margin-top: 18rpx;
  margin-bottom: 70rpx;
}

.weekday-row {
  display: flex;
  flex-direction: row;
  margin-bottom: 22rpx;
}

.weekday-cell {
  width: 14.28%;
  color: #05070c;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: center;
  box-sizing: border-box;
}

.month-days {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.day-cell {
  position: relative;
  width: 14.28%;
  height: 92rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  color: #05070c;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 92rpx;
  text-align: center;
  box-sizing: border-box;
}

.day-cell.blank {
  color: transparent;
}

.day-label {
  position: relative;
  z-index: 1;
  display: block;
}

.tennis-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 0;
  color: #05070c;
  font-size: 54rpx;
  line-height: 1;
  opacity: 0.82;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.day-cell.marked {
  color: #05070c;
}

.day-cell.today {
  background: #3f82e8;
  color: #fff;
}

.day-cell:active {
  opacity: 0.72;
}

.day-cell.blank:active {
  opacity: 1;
}
