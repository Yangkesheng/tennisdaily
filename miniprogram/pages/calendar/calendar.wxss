.calendar-page {
  min-height: 100vh;
  padding: 28rpx 32rpx 56rpx;
  background: #f7f7f9;
  box-sizing: border-box;
}

.panel-handle {
  width: 92rpx;
  height: 12rpx;
  margin: 0 auto 34rpx;
  border-radius: 999rpx;
  background: #d7dbe3;
}

.calendar-head,
.calendar-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.calendar-head {
  margin-bottom: 52rpx;
}

.calendar-tabs {
  display: flex;
  align-items: flex-end;
  gap: 38rpx;
}

.muted-tab {
  color: #a8aab0;
  font-size: 36rpx;
  font-weight: 700;
}

.muted-tab:active,
.active-tab:active {
  opacity: 0.72;
}

.active-tab {
  position: relative;
  color: #05070c;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1;
}

.active-tab::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: -14rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #4b88eb;
}

.calendar-summary {
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
  color: #05070c;
  font-size: 36rpx;
  font-weight: 800;
}

.calendar-toolbar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.calendar-summary.stats-summary {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.active-count {
  text-align: right;
}

.month-switcher {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
  flex-wrap: nowrap;
  white-space: nowrap;
}

.stats-summary .month-switcher {
  flex: none;
  min-width: 0;
}

.month-current {
  display: flex;
  min-width: 0;
  padding: 0 8rpx;
  align-items: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
  white-space: nowrap;
}

.month-current:active {
  background: #eef2f8;
  opacity: 0.72;
}

.date-number {
  color: #3f82e8;
}

.date-unit {
  color: #7b808a;
}

.month-current.year-only {
  min-width: 0;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
}

.month-nav {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #eef2f8;
  color: #3f82e8;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.month-nav-active {
  opacity: 0.72;
}

.month-nav.disabled {
  color: #b8bec8;
  background: #f1f3f6;
  opacity: 0.52;
}

.months {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 0;
}

.months.year-months {
  justify-content: space-between;
}

.month-card {
  width: 100%;
  margin-top: 18rpx;
  margin-bottom: 70rpx;
}

.year-months .month-card {
  width: 48%;
  margin-bottom: 34rpx;
}

.month-title {
  display: block;
  margin-bottom: 12rpx;
  color: #05070c;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.weekday-row {
  display: flex;
  flex-direction: row;
  margin-bottom: 22rpx;
}

.year-months .weekday-row {
  margin-bottom: 10rpx;
}

.weekday-cell {
  width: 14.28%;
  color: #05070c;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: center;
  box-sizing: border-box;
}

.year-months .weekday-cell {
  font-size: 20rpx;
  line-height: 30rpx;
}

.month-days {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.day-cell {
  position: relative;
  width: 14.28%;
  height: 92rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  color: #05070c;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 92rpx;
  text-align: center;
  box-sizing: border-box;
}

.year-months .day-cell {
  height: 46rpx;
  margin-bottom: 8rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  line-height: 46rpx;
}

.day-cell.blank {
  color: transparent;
}

.day-label {
  position: relative;
  z-index: 1;
  display: block;
}

.tennis-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 0;
  color: #05070c;
  font-size: 54rpx;
  line-height: 1;
  opacity: 0.82;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.year-months .tennis-mark {
  font-size: 30rpx;
}

.day-cell.marked {
  color: #05070c;
}

.day-cell.today {
  border: 4rpx solid #3f82e8;
  background: transparent;
  color: #3f82e8;
  line-height: 84rpx;
}

.year-months .day-cell.today {
  border-width: 2rpx;
  line-height: 42rpx;
}

.day-cell:active {
  opacity: 0.72;
}

.day-cell.blank:active {
  opacity: 1;
}

.stats-panel {
  padding-top: 22rpx;
}

.jump-current {
  position: absolute;
  left: 50%;
  top: 0;
  z-index: 1;
  flex: none;
  color: #3f82e8;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 48rpx;
  white-space: nowrap;
  transform: translateX(-50%);
}

.jump-current:active {
  opacity: 0.72;
}

.period-switcher {
  flex: none;
  display: flex;
  width: 132rpx;
  margin: 0;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #eef2f8;
  box-sizing: border-box;
}

.calendar-toolbar .period-switcher {
  margin-left: auto;
}

.period-option {
  flex: 1;
  border-radius: 999rpx;
  color: #7b808a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
}

.period-option.active {
  background: #fff;
  color: #3f82e8;
  box-shadow: 0 8rpx 20rpx rgba(63, 130, 232, 0.14);
}

.stats-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 18rpx 48rpx rgba(13, 23, 40, 0.06);
  box-sizing: border-box;
}

.stats-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stats-card-title {
  color: #05070c;
  font-size: 30rpx;
  font-weight: 800;
}

.stats-card-subtitle {
  min-width: 0;
  color: #7b808a;
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.overview-item {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f7f9fc;
  box-sizing: border-box;
}

.overview-value {
  display: block;
  color: #05070c;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
}

.overview-label {
  display: block;
  margin-top: 10rpx;
  color: #7b808a;
  font-size: 22rpx;
  font-weight: 700;
}

.overview-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  margin-top: 10rpx;
}

.overview-label-row .overview-label {
  margin-top: 0;
}

.expense-eye {
  flex: none;
  color: rgba(13, 23, 40, 0.48);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.expense-eye:active {
  opacity: 0.62;
}

.bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10rpx;
  min-height: 230rpx;
}

.bar-column {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bar-number {
  height: 30rpx;
  color: #05070c;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.bar-track-vertical {
  display: flex;
  width: 100%;
  height: 150rpx;
  align-items: flex-end;
  justify-content: center;
}

.bar-fill {
  width: 34rpx;
  min-height: 0;
  border-radius: 14rpx 14rpx 6rpx 6rpx;
}

.bar-fill.frequency {
  background: linear-gradient(180deg, #3f82e8 0%, rgba(63, 130, 232, 0.36) 100%);
}

.bar-fill.rating {
  background: linear-gradient(180deg, #ffc928 0%, rgba(255, 201, 40, 0.38) 100%);
}

.bar-label {
  max-width: 100%;
  margin-top: 12rpx;
  color: #7b808a;
  font-size: 18rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.breakdown-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.breakdown-list.compact {
  gap: 18rpx;
}

.breakdown-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 10rpx;
  color: #05070c;
  font-size: 24rpx;
  font-weight: 700;
}

.breakdown-track {
  width: 100%;
  height: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eef2f8;
}

.breakdown-fill {
  height: 100%;
  min-width: 0;
  border-radius: 999rpx;
}

.breakdown-fill.expense {
  background: linear-gradient(90deg, #50cb70 0%, #9be7ad 100%);
}

.breakdown-fill.type {
  background: linear-gradient(90deg, #2bc5d8 0%, #9ae8f0 100%);
}

.breakdown-fill.session-cost {
  background: linear-gradient(90deg, #3f82e8 0%, #9cc5ff 100%);
}

.breakdown-fill.session-sub-cost {
  background: linear-gradient(90deg, #ffc928 0%, #ffe59a 100%);
}

.pie-chart-block {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.pie-chart {
  position: relative;
  flex: none;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: #eef2f8;
  box-shadow: inset 0 0 0 1rpx rgba(13, 23, 40, 0.04);
}

.pie-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #fff;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 0 1rpx rgba(13, 23, 40, 0.04);
}

.pie-percent-label {
  position: absolute;
  z-index: 1;
  padding: 2rpx 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #05070c;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 24rpx;
  white-space: nowrap;
  transform: translate(-50%, -50%);
  box-shadow: 0 2rpx 8rpx rgba(13, 23, 40, 0.08);
}

.pie-legend {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.pie-legend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pie-legend-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pie-dot {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.pie-label {
  min-width: 0;
  color: #05070c;
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pie-value {
  flex: none;
  color: #7b808a;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.large-legend {
  align-items: flex-start;
}

.large-legend .pie-chart {
  margin-top: 10rpx;
}

.stats-empty {
  color: #9aa1ad;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 120rpx;
  text-align: center;
}
