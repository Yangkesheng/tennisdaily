.calendar-page {
  min-height: 100vh;
  padding: 28rpx 32rpx 56rpx;
  background: #f7f7f9;
  box-sizing: border-box;
}

.panel-handle {
  width: 92rpx;
  height: 12rpx;
  margin: 0 auto 34rpx;
  border-radius: 999rpx;
  background: #d7dbe3;
}

.calendar-head,
.calendar-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.calendar-head {
  margin-bottom: 52rpx;
}

.calendar-tabs {
  display: flex;
  align-items: flex-end;
  gap: 38rpx;
}

.muted-tab {
  color: #a8aab0;
  font-size: 36rpx;
  font-weight: 700;
}

.active-tab {
  position: relative;
  color: #05070c;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1;
}

.active-tab::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: -14rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #4b88eb;
}

.calendar-summary {
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  color: #05070c;
  font-size: 36rpx;
  font-weight: 800;
}

.calendar-summary text:last-child {
  color: #7b808a;
  font-size: 26rpx;
}

.months {
  display: block;
}

.month-card {
  width: 100%;
  margin-bottom: 70rpx;
}

.month-title {
  display: block;
  margin-bottom: 20rpx;
  color: #05070c;
  font-size: 34rpx;
  font-weight: 800;
}

.month-days {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.28%;
  height: 76rpx;
  margin-bottom: 12rpx;
  border-radius: 22rpx;
  color: #05070c;
  font-size: 28rpx;
  line-height: 76rpx;
  text-align: center;
  box-sizing: border-box;
}

.day-cell.blank {
  color: transparent;
}

.day-cell.marked {
  background: #a9c7f3;
  color: #fff;
}

.day-cell.today {
  background: #3f82e8;
  color: #fff;
}

.day-cell:active {
  opacity: 0.72;
}

.day-cell.blank:active {
  opacity: 1;
}
