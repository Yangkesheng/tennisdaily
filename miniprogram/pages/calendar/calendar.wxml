<navigation-bar title="" back="{{false}}" color="#0d1728" background="#f7f7f9"></navigation-bar>
<scroll-view class="page calendar-page" scroll-y type="list">
  <view class="panel-handle"></view>
  <view class="calendar-head">
    <view class="calendar-tabs">
      <text class="active-tab">日历</text>
      <text class="muted-tab">统计</text>
    </view>
  </view>
  <view class="calendar-summary">
    <text>{{activeDayCount}} 天</text>
    <text>{{currentYear}}</text>
  </view>
  <view class="months">
    <view wx:for="{{calendarMonths}}" wx:key="key" wx:for-item="month" class="month-card">
      <text class="month-title">{{month.label}}</text>
      <view class="month-days">
        <view
          wx:for="{{month.days}}"
          wx:key="key"
          wx:for-item="day"
          bindtap="goDaySessions"
          data-date="{{day.marked ? day.key : ''}}"
          class="day-cell {{day.blank ? 'blank' : ''}} {{day.marked ? 'marked' : ''}} {{day.today ? 'today' : ''}}"
        >
          {{day.label}}
        </view>
      </view>
    </view>
  </view>
</scroll-view>
