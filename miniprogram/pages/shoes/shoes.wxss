.shoes-page {
  min-height: 100vh;
  padding: 34rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  background: linear-gradient(45deg, #f5efe6 0%, #eed6ca 50%, #e2bda9 100%);
  box-sizing: border-box;
  color: #05070c;
}

.shoe-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
}

.delete-action {
  position: absolute;
  top: 0;
  right: 0;
  width: 180rpx;
  height: 100%;
  border-radius: 0 32rpx 32rpx 0;
  padding-left: 30rpx;
  background: #d93025;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.shoe-card {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 34rpx 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 32rpx;
  background: #fff;
  box-sizing: border-box;
  transform: translateX(0);
  transition: transform 0.18s ease;
}

.shoe-card.opened {
  transform: translateX(-180rpx);
}

.shoe-mark {
  flex: none;
  width: 208rpx;
  height: 208rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shoe-image {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
}

.shoe-mark text {
  max-width: 164rpx;
  color: rgba(13, 23, 40, 0.62);
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
}

.shoe-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.shoe-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.shoe-title {
  min-width: 0;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.18;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 3;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 900;
}

.status-badge.primary,
.status-badge.active {
  background: rgba(55, 120, 219, 0.76);
}

.status-badge.retired {
  background: rgba(13, 23, 40, 0.34);
}

.meta-line {
  display: block;
  margin-top: 12rpx;
  color: rgba(13, 23, 40, 0.56);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.purchase-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  color: rgba(13, 23, 40, 0.42);
  font-size: 22rpx;
  font-weight: 800;
}

.purchase-line text:last-child {
  color: #05070c;
  font-size: 24rpx;
}

.empty-equipment {
  height: 220rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.52);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(13, 23, 40, 0.46);
  font-size: 28rpx;
  font-weight: 800;
}

.add-shoe {
  position: fixed;
  right: 32rpx;
  bottom: calc(64rpx + env(safe-area-inset-bottom));
  height: 78rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: #2b61b3;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 78rpx;
  box-shadow: 0 18rpx 42rpx rgba(43, 97, 179, 0.36);
}
